// The Coach Cuts window (spec D9, D10, D11): sidebar, player area with its
// zoom and empty-state cards, transport bar, error dialog, and the keyboard.
//
// Everything here is presentation. `src/main.rs` turns the callbacks into bus
// commands and feeds bus events back in through the `in` properties.

import { Button, CheckBox, LineEdit, ListView, Palette, ProgressIndicator, Slider, TextEdit } from "std-widgets.slint";

/// One row of the sidebar's Sources list.
export struct SourceRow {
    name: string,
    /// Already formatted.
    duration: string,
    missing: bool,
    /// Used by a clip or match event, so it can't be removed.
    referenced: bool,
}

/// One row of the sidebar's Clips list, in the project's order.
export struct ClipRow {
    /// The clip's UUID.
    id: string,
    /// "Untitled" for an empty name.
    name: string,
    /// The recording's length, already formatted.
    duration: string,
}

/// One row of the tag overview (Phase 3 C8).
export struct TagRow {
    tag: string,
    /// "3 clips · 1:24", already formatted.
    detail: string,
}

/// The inspector's text fields, for `edit-clip`.
export enum ClipField {
    name,
    tags,
    notes,
}

/// One row of the Devices popover's camera or microphone list.
export struct DeviceRow {
    /// PipeWire's `node.name`, the stored preference; empty for "System
    /// default".
    node-name: string,
    label: string,
    /// The project's current choice.
    chosen: bool,
}

/// The recording as the UI last heard it from the bus (Phase 4 R6).
export enum RecordingPhase {
    idle,
    /// Recording, but the camera hasn't delivered a frame yet.
    starting,
    recording,
}

/// Zoom and pan (spec D9), mirrored from the Rust side, which owns it.
export struct ZoomState {
    scale: float,
    pan-x: float,
    pan-y: float,
}

/// Where the picture is drawn in the player area.
export struct PictureRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

/// The zoom readout (spec D9, macOS `ZoomIndicator`): the scale over a
/// logarithmic track from 1× to 10×, with ticks at the snap notches. Hidden
/// at 1×, where there's nothing to read.
component ZoomIndicator inherits Rectangle {
    in property <float> scale;
    in property <[float]> notches;

    /// 1× is the left end, 10× the right: log10(scale).
    function track-x(scale: float) -> length {
        max(0, min(1, log(max(scale, 1), 10))) * track.width
    }

    width: row.preferred-width;
    height: row.preferred-height;
    background: #0000008c;
    border-radius: 6px;
    opacity: root.scale > 1 ? 1 : 0;
    animate opacity { duration: 180ms; easing: ease-out; }

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;

        Text {
            text: root.scale.to-fixed(2) + "×";
            color: white;
            font-size: 12px;
            font-weight: 600;
            font-family: "monospace";
            width: 56px;
            vertical-alignment: center;
        }

        track := Rectangle {
            width: 140px;
            height: 12px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 3px;
                border-radius: 1.5px;
                background: #ffffff40;
            }
            for notch in root.notches: Rectangle {
                x: root.track-x(notch) - 0.5px;
                y: (parent.height - self.height) / 2;
                width: 1px;
                height: 9px;
                background: #ffffff8c;
            }
            Rectangle {
                x: root.track-x(root.scale) - 4.5px;
                y: (parent.height - self.height) / 2;
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: white;
            }
        }
    }
}

/// A card over the player area: the next thing to do when there's nothing to
/// play.
component EmptyCard inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> action;
    in property <bool> enabled: true;
    callback clicked();

    background: black;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 40px;

        Text {
            text: root.title;
            color: white;
            font-size: 20px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: root.message;
                color: #ffffffb3;
                wrap: word-wrap;
                horizontal-alignment: center;
                width: min(420px, root.width - 80px);
            }
        }

        HorizontalLayout {
            alignment: center;
            Button {
                text: root.action;
                primary: true;
                enabled: root.enabled;
                clicked => { root.clicked(); }
            }
        }
    }
}

/// A row of the Devices popover: the device, checked if it's the choice.
/// Clicking it picks it (and closes the popover).
component DeviceChoice inherits Rectangle {
    in property <string> label;
    in property <bool> chosen;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.selection-background : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;

        Text {
            text: root.chosen ? "✓" : "";
            color: Palette.foreground;
            width: 14px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: Palette.foreground;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

/// One of the Devices popover's lists, under its title. Picking a row reports
/// its `node-name`.
component DeviceList inherits VerticalLayout {
    in property <string> title;
    in property <[DeviceRow]> rows;
    callback chosen(string);

    spacing: 4px;

    Text {
        text: root.title;
        color: Palette.alternate-foreground;
        font-size: 11px;
    }
    if root.rows.length == 0: Text {
        text: "Looking for devices…";
        color: Palette.alternate-foreground;
    }
    for row in root.rows: DeviceChoice {
        label: row.label;
        chosen: row.chosen;
        clicked => { root.chosen(row.node-name); }
    }
}

/// A caption over one of the inspector's fields.
component FieldLabel inherits Text {
    color: Palette.alternate-foreground;
    font-size: 11px;
}

/// The selected clip's fields (Phase 3 C7). The window renders them through
/// the `in-out` properties, and the fields report focus and commits; which
/// clip a commit is for is the window's business.
component Inspector inherits Rectangle {
    in property <bool> enabled;
    in-out property <string> name-text;
    in-out property <string> tags-text;
    in-out property <string> notes-text;
    in-out property <bool> show-pip;
    /// A field has focus: the window's shortcuts yield to it.
    out property <bool> editing: name.has-focus || tags.has-focus || notes.has-focus;
    /// Preview is possible at all (Phase 7 P6): something to play, and
    /// neither recording nor exporting, both of which the bus refuses.
    in property <bool> can-preview;
    /// This clip is the one on screen, so the button closes it instead.
    in property <bool> previewing;
    /// The Preview button: open a preview of this clip, or close the one
    /// showing it. Opening is explicit (P5) -- Space plays the game video
    /// until a preview is open.
    callback preview-clicked();

    /// A field gained focus ...
    callback begin-edit();
    /// ... pressed Enter (a commit that keeps focus) ...
    callback commit(ClipField, string);
    /// ... or lost focus, which commits.
    callback end-edit(ClipField, string);
    callback pip-toggled(bool);
    /// Existing tags to suggest for the tag field's text (C8).
    pure callback suggest-tags(string) -> [string];
    /// The tag field's text with the suggestion taken.
    pure callback take-suggestion(string, string) -> string;

    /// For the tag field's current fragment, from its last edit.
    property <[string]> suggestions;
    /// Esc closed them; the next edit reopens them.
    property <bool> suggestions-dismissed;
    property <bool> suggesting: tags.has-focus && root.suggestions.length > 0 && !root.suggestions-dismissed;

    function focus-changed(field: ClipField, focused: bool, text: string) {
        root.suggestions = [];
        if (focused) {
            root.begin-edit();
        } else {
            root.end-edit(field, text);
        }
    }

    /// Takes `tag` into the tag field, keeping focus, with the cursor at the
    /// end. It doesn't commit: Enter or leaving the field does.
    function take(tag: string) {
        root.tags-text = root.take-suggestion(root.tags-text, tag);
        root.suggestions = [];
        // Past the end, which clamps to it.
        tags.set-selection-offsets(2147483647, 2147483647);
    }

    layout := VerticalLayout {
        padding: 12px;
        spacing: 6px;

        FieldLabel { text: "Name"; }
        name := LineEdit {
            enabled: root.enabled;
            placeholder-text: "Untitled";
            text <=> root.name-text;
            accepted(text) => { root.commit(ClipField.name, text); }
            changed has-focus => { root.focus-changed(ClipField.name, self.has-focus, self.text); }
        }

        FieldLabel { text: "Tags"; }
        // A direct child of the layout, so its x and y place the suggestions.
        tags := LineEdit {
            enabled: root.enabled;
            placeholder-text: "Comma-separated";
            text <=> root.tags-text;
            accepted(text) => {
                root.suggestions = [];
                root.commit(ClipField.tags, text);
            }
            changed has-focus => { root.focus-changed(ClipField.tags, self.has-focus, self.text); }
            edited(text) => {
                root.suggestions-dismissed = false;
                root.suggestions = root.suggest-tags(text);
            }
            // Tab takes the top suggestion; Esc closes them. Otherwise Tab
            // moves focus on, and Esc bubbles to the window, which leaves the
            // field.
            key-pressed(event) => {
                if (root.suggesting && event.text == Key.Tab) {
                    root.take(root.suggestions[0]);
                    return accept;
                }
                if (root.suggesting && event.text == Key.Escape) {
                    root.suggestions-dismissed = true;
                    return accept;
                }
                reject
            }
        }

        CheckBox {
            text: "Show webcam in export";
            enabled: root.enabled;
            checked <=> root.show-pip;
            toggled => { root.pip-toggled(self.checked); }
        }

        FieldLabel { text: "Notes"; }
        notes := TextEdit {
            enabled: root.enabled;
            vertical-stretch: 1;
            text <=> root.notes-text;
            changed has-focus => { root.focus-changed(ClipField.notes, self.has-focus, self.text); }
        }

        Button {
            text: root.previewing ? "Close Preview" : "Preview";
            primary: !root.previewing;
            // Closing is always possible; opening needs the bus to be idle.
            enabled: root.previewing || root.can-preview;
            clicked => { root.preview-clicked(); }

            Tooltip {
                text: root.previewing
                    ? @markdown("Close the preview (Esc)")
                    : @markdown("Play this clip as it was recorded");
            }
        }
    }

    // Over the fields below, not a `PopupWindow`, whose `show()` would take
    // focus from the field and commit it (C8).
    if root.suggesting: Rectangle {
        x: tags.x;
        y: tags.y + tags.height + 2px;
        width: tags.width;
        height: suggestion-list.preferred-height;
        background: Palette.background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border;

        suggestion-list := VerticalLayout {
            padding: 4px;

            for tag in root.suggestions: Rectangle {
                height: 26px;
                border-radius: 4px;
                background: suggestion-touch.has-hover ? Palette.selection-background : transparent;

                // A click doesn't take focus from the field.
                suggestion-touch := TouchArea {
                    clicked => { root.take(tag); }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: tag;
                        color: Palette.foreground;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

/// With nothing selected, the inspector's column lists the project's tags
/// (C8). Clicking one filters the Clips list by it, or clears that filter.
component TagOverview inherits VerticalLayout {
    in property <[TagRow]> rows;
    in property <int> clip-count;
    in-out property <string> filter;

    padding: 12px;
    spacing: 8px;

    FieldLabel { text: "Tags"; }
    if root.clip-count == 0: Text {
        text: "No clips yet";
        color: Palette.alternate-foreground;
    }
    if root.clip-count > 0 && root.rows.length == 0: Text {
        text: "No tags yet — add tags to a clip in the inspector.";
        color: Palette.alternate-foreground;
        wrap: word-wrap;
    }
    ListView {
        for row in root.rows: Rectangle {
            height: 40px;
            border-radius: 4px;
            background: row.tag == root.filter || tag-touch.has-hover ? Palette.selection-background : transparent;

            tag-touch := TouchArea {
                clicked => { root.filter = root.filter == row.tag ? "" : row.tag; }
            }
            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                spacing: 2px;

                Text {
                    text: row.tag;
                    color: Palette.foreground;
                    overflow: elide;
                }
                Text {
                    text: row.detail;
                    color: Palette.alternate-foreground;
                    font-size: 11px;
                }
            }
        }
    }
}

/// One live telestration stroke (Phase 6 D5). Its `commands` are in the
/// content rect's logical pixels, which `fit: preserve` takes as they are:
/// it short-circuits before any bounding-box or stroke-width fitting, so no
/// viewbox is needed. The caller sets `commands` and `stroke-width`.
///
/// `fill` stays unset on purpose: a fill on an open polyline fills the area
/// the line encloses.
component StrokePath inherits Path {
    width: 100%;
    height: 100%;
    fit: preserve;
    // Exactly core's `Rgba::RED`, which export burns in (Phase 8).
    stroke: #ff3333;
    // Exactly `drawing::LINE_WIDTH`, a fraction of the picture's height,
    // which is what the logged stroke carries and export burns in. `self` is
    // the content rect, by the 100% above.
    stroke-width: self.height * 0.005;
    // Round caps also make a single point (`M x y L x y`) a dot.
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component AppWindow inherits Window {
    title: "Coach Cuts";
    min-width: 1100px;
    min-height: 700px;
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Palette.background;
    forward-focus: keys;

    // --- Video (set by the renderer bridge in `src/video.rs`) ---

    /// The newest video frame (a borrowed GL texture).
    in property <image> frame;
    /// Display size of `frame`, from the negotiated caps (pixel aspect ratio
    /// included), so the picture is never stretched. Only its shape matters.
    in property <float> frame-width: 16;
    in property <float> frame-height: 9;

    // --- Zoom (spec D9; the state and the math are on the Rust side) ---

    in property <ZoomState> zoom: { scale: 1 };
    /// Core's `SNAP_NOTCHES`, for the indicator's ticks.
    in property <[float]> zoom-notches;
    out property <length> player-width: player.width;
    out property <length> player-height: player.height;
    /// The content rect: the letterboxed picture at 1×, which the drawing
    /// area is sized to and strokes are normalized against (Phase 6 D2).
    /// Zero before the first layout, or with nothing loaded.
    out property <length> content-width: player.content.width;
    out property <length> content-height: player.content.height;
    /// The picture's rect at `zoom`. Pure, so the binding that calls it is
    /// re-evaluated whenever an argument changes.
    pure callback place-picture(ZoomState, float, float, length, length) -> PictureRect;
    /// A scroll over the player at (x, y): pan, or zoom with Ctrl.
    callback zoom-scroll(length, length, length, length, bool, bool);
    /// The primary button went down over the player at (x, y) ...
    callback zoom-press(length, length);
    /// ... and, still down, the pointer moved to (x, y).
    callback zoom-drag(length, length);

    // --- Project state (from bus events) ---

    in property <bool> has-project;
    /// The project-name field's text.
    in-out property <string> project-name;
    /// The name the field returns to when it loses focus: the project's, or
    /// a rename just sent.
    in property <string> saved-project-name;
    changed saved-project-name => {
        // Never over a name being typed: leaving the field shows it.
        if (!name-edit.has-focus) {
            root.project-name = self.saved-project-name;
        }
    }
    in property <[SourceRow]> sources;
    /// The first missing source, or -1.
    in property <int> missing-index: -1;
    in property <string> missing-name;
    in property <bool> playing;
    /// Sources, none missing: play, seek and scrub are possible.
    in property <bool> can-play;

    // --- Transport ---

    /// Concat-timeline length, seconds.
    in property <float> total-seconds;
    /// The scrubber's value, concat seconds. Set by the 30 Hz timer except
    /// while `scrubbing`.
    in-out property <float> position-seconds;
    /// A scrub drag is under way. Cleared if the scrubber is disabled
    /// mid-drag, which never delivers its `released`.
    out property <bool> scrubbing;
    /// Scrubbing is possible: something to play, and not recording.
    property <bool> can-scrub: root.can-play && !root.recording;
    changed can-scrub => {
        if (!self.can-scrub) {
            self.scrubbing = false;
        }
    }
    /// `current / total`.
    in property <string> readout: "0:00 / 0:00";
    /// Linear 0..1.
    in-out property <float> volume: 1;

    // --- Recording (Phase 4 R11) ---

    in property <RecordingPhase> recording-phase;
    /// Not idle. Greys out everything the bus refuses while recording (R6's
    /// guard): the source and clip lists, Open Project, rename, the scrubber
    /// and the Devices button.
    out property <bool> recording: root.recording-phase != RecordingPhase.idle;
    /// Time since the recording's t0, already formatted.
    in property <string> recording-elapsed: "0:00";
    /// The microphone's peak as a fraction of the level bar, 0..1.
    in property <float> level;
    /// A level has arrived during this recording.
    in property <bool> level-seen;
    /// The Clips list: the project's clips, or only those tagged
    /// `tag-filter`.
    in property <[ClipRow]> clips;
    /// All the project's clips, filtered or not.
    in property <int> clip-count;
    /// The selected clip's id, empty for none (Phase 3 C7). UI state only:
    /// `src/main.rs` sets it on the bus's `Select`, and clears it on project
    /// open and when its clip leaves the project.
    in-out property <string> selected-clip;
    changed selected-clip => {
        // Its clip is gone: off a field the inspector is hiding.
        if (self.selected-clip == "") {
            keys.focus();
        }
        root.show-clip();
    }
    /// The inspector's fields (C7), set imperatively by `show-clip`: a
    /// `text:` or `checked:` binding breaks once the user types or clicks.
    in-out property <string> clip-name;
    in-out property <string> clip-tags;
    in-out property <string> clip-notes;
    in-out property <bool> clip-show-pip;
    /// The clip an inspector field is editing, set when one gains focus and
    /// cleared when the last one loses it. Commits go to it, not to the
    /// selection, which a row click has already moved by the time a field's
    /// focus-loss handler runs. `show-clip` leaves the fields alone while
    /// it's set.
    in-out property <string> editing-clip-id;
    /// The tag overview's rows, alphabetical.
    in property <[TagRow]> tag-rows;
    /// Show only the clips with this tag; empty for all (C8). UI state only.
    in-out property <string> tag-filter;
    changed tag-filter => { root.filter-changed(); }
    /// The Devices popover's lists, "System default" first. Empty while
    /// they're being looked up.
    in property <[DeviceRow]> cameras;
    in property <[DeviceRow]> mics;

    // --- Drawing on the picture (Phase 6 D1, D5, D6) ---

    /// Only while recording, never `starting`: `recording` is the broader
    /// "not idle".
    out property <bool> can-draw: root.recording-phase == RecordingPhase.recording;
    /// A finished drawing clears itself 5 s after the pen lifts. UI state;
    /// `src/main.rs` reads it at pen-up.
    in-out property <bool> auto-clear: true;
    /// The live overlay: one SVG command string per stroke still on screen,
    /// in content-rect logical pixels. `src/main.rs` rebuilds it only when
    /// something changes (D5) — Slint re-parses a `Path` on every set.
    in property <[string]> live-paths;
    /// The stroke under the pen, likewise; empty when nothing is being drawn.
    in property <string> drawing-path;

    // --- Export (Phase 5 X5) ---

    /// The running export's whole percent; negative with none running.
    in property <int> export-progress: -1;
    /// Greys out Record and "Export video…": the bus refuses both while an
    /// export runs.
    out property <bool> exporting: root.export-progress >= 0;

    // --- Preview (Phase 7 P6) ---

    /// The clip on screen instead of the game video, empty with none, and its
    /// name for the indicator. Set from the bus's `Preview` event.
    in property <string> previewing-clip;
    in property <string> previewing-name;
    out property <bool> previewing: root.previewing-clip != "";
    /// Opening one is refused while recording or exporting (P5), and needs
    /// something to play.
    out property <bool> can-preview: root.can-play && !root.recording && !root.exporting;

    /// The latest notice (a device fallback, an unclean stop, an export
    /// done), shown in the transport bar without blocking; empty hides it.
    in property <string> notice;

    /// The error dialog's message; empty hides it.
    in-out property <string> error-message;
    /// A text field has focus: every shortcut yields to it (C6).
    property <bool> text-editing: name-edit.has-focus || inspector.editing;

    callback open-project();
    callback add-source();
    callback relink-source(int);
    callback remove-source(int);
    callback move-source(int, int);
    callback rename-project(string);
    callback toggle-play();
    /// Skip by this many seconds (negative is backwards).
    callback skip(float);
    callback scrub-move(float);
    callback scrub-release(float);
    /// R, Record or Stop: the bus starts a recording when idle, else stops
    /// (or aborts) it.
    callback toggle-recording();
    /// Esc: stop (or abort) the recording.
    callback stop-recording();
    /// The Devices popover opened: look the devices up.
    callback list-devices();
    /// A row of the popover's camera or microphone list was picked: its
    /// `node-name`, empty for the system default.
    callback choose-camera(string);
    callback choose-mic(string);
    /// Clips (Phase 3 C5), by id; `move-clip` takes list indices.
    callback jump-to-clip(string);
    callback delete-clip(string);
    callback move-clip(int, int);
    callback sort-clips();
    /// Ask where, then export the clip with this id.
    callback export-clip(string);
    callback cancel-export();
    /// Preview the clip with this id, in place of the game video, and close
    /// the one open (P5).
    callback open-preview(string);
    callback close-preview();
    callback undo();
    callback redo();
    /// An inspector field's commit for clip `id`.
    callback edit-clip(string, ClipField, string);
    callback set-show-pip(string, bool);
    /// Render the inspector's fields from the selected clip, unless one is
    /// being edited.
    callback show-clip();
    /// `tag-filter` changed: list the clips it lets through.
    callback filter-changed();
    pure callback suggest-tags(string) -> [string];
    pure callback take-suggestion(string, string) -> string;
    callback volume-changed(float);
    callback volume-released(float);
    /// Zoom keys (spec D9): `1`/`Ctrl+0` reset; `2`/`3` step the scale about
    /// the pointer at (x, y) when it's over the player (the bool).
    callback zoom-reset();
    callback zoom-step(float, bool, length, length);
    /// Drawing (Phase 6 D2): the pen went down at (x, y) over the picture,
    /// moved with it down, and came up. Content-rect relative, and the last
    /// two may be outside it: Slint grabs the pointer on press.
    callback draw-press(length, length);
    callback draw-move(length, length);
    callback draw-release(length, length);
    /// The grab was taken away mid-stroke (see the drawing area): whatever is
    /// under the pen is dropped, unlogged.
    callback draw-cancel();
    /// Clear: the button, or C.
    callback clear-drawings();
    /// Drag-to-reorder payload: a row index of the named list ("sources" or
    /// "clips") to and from `data-transfer`; -1 when it's another list's.
    pure callback drag-payload(string, int) -> data-transfer;
    pure callback dropped-index(string, data-transfer) -> int;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    /// Spec D10: every shortcut, ahead of whichever child has focus, so a
    /// touched slider never turns arrows into volume or scrub steps. Called
    /// for releases too (`pressed` false), which are swallowed for the same
    /// keys: a slider fires `released` on an arrow key's release.
    function handle-key(event: KeyEvent, pressed: bool) -> EventResult {
        if (root.error-message != "") {
            // Modal: nothing reaches the window behind the dialog.
            if (pressed && (event.text == Key.Return || event.text == Key.Escape)) {
                root.error-message = "";
            }
            return accept;
        }
        // The field gets them all, Esc included: it bubbles back to
        // `key-pressed` below.
        if (root.text-editing) {
            return reject;
        }
        // No shortcut, but a touched slider would take them.
        if (event.text == Key.Home || event.text == Key.End) {
            return accept;
        }
        if (event.modifiers.control) {
            if (event.text == "o" || event.text == "O") {
                if (pressed && !root.recording) {
                    root.open-project();
                }
                return accept;
            }
            // Not while previewing: the picture is at identity zoom then
            // (P6), so a change would only show once it closes.
            if (event.text == "0") {
                if (pressed && !root.previewing) {
                    root.zoom-reset();
                }
                return accept;
            }
            // Ctrl+Z undoes; Ctrl+Shift+Z (Z shifted) or Ctrl+Y redoes. Not
            // while recording, which the bus refuses.
            if (event.text == "z" || event.text == "Z" || event.text == "y" || event.text == "Y") {
                if (pressed && !root.recording) {
                    if (event.text == "y" || event.text == "Y" || event.modifiers.shift) {
                        root.redo();
                    } else {
                        root.undo();
                    }
                }
                return accept;
            }
            return reject;
        }
        // Clear the drawings (D6). After the Ctrl branch, so Ctrl+C isn't it.
        // A held C would clear over and over, which does nothing but log.
        if (event.text == "c" || event.text == "C") {
            if (pressed && !event.repeat && root.can-draw) {
                root.clear-drawings();
            }
            return accept;
        }
        // R and Space toggle, so an auto-repeat would toggle straight back.
        if (event.text == "r" || event.text == "R") {
            if (pressed && !event.repeat) {
                root.toggle-recording();
            }
            return accept;
        }
        // Esc cascade (C6, P6): the dialog above, then the recording, then
        // the preview, then the selection.
        if (event.text == Key.Escape) {
            if (pressed) {
                if (root.recording) {
                    root.stop-recording();
                } else if (root.previewing) {
                    root.close-preview();
                } else {
                    root.selected-clip = "";
                }
            }
            return accept;
        }
        if (event.text == Key.Delete) {
            if (pressed && !root.recording && root.selected-clip != "") {
                root.delete-clip(root.selected-clip);
            }
            return accept;
        }
        if (event.text == " ") {
            if (pressed && !event.repeat) {
                root.toggle-play();
            }
            return accept;
        }
        if (event.text == Key.LeftArrow || event.text == "a" || event.text == "A") {
            if (pressed) {
                root.skip(event.modifiers.shift ? -10 : -3);
            }
            return accept;
        }
        if (event.text == Key.RightArrow || event.text == "d" || event.text == "D") {
            if (pressed) {
                root.skip(event.modifiers.shift ? 10 : 3);
            }
            return accept;
        }
        if (event.text == "1") {
            if (pressed && !root.previewing) {
                root.zoom-reset();
            }
            return accept;
        }
        if (event.text == "2" || event.text == "3") {
            if (pressed && !root.previewing) {
                root.zoom-step(event.text == "2" ? -0.25 : 0.25, zoom-area.has-hover, zoom-area.mouse-x, zoom-area.mouse-y);
            }
            return accept;
        }
        reject
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            root.handle-key(event, true)
        }
        capture-key-released(event) => {
            root.handle-key(event, false)
        }
        // Esc a field didn't take leaves it, which commits it (C6). The only
        // way out of the notes field by keyboard.
        key-pressed(event) => {
            if (root.text-editing && event.text == Key.Escape) {
                keys.focus();
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                // --- Sidebar ---
                Rectangle {
                    width: 240px;
                    background: Palette.alternate-background;

                    // Empty space: off any field (C6), which Slint doesn't do
                    // on a click.
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Project";
                            color: Palette.alternate-foreground;
                            font-size: 11px;
                        }

                        name-edit := LineEdit {
                            enabled: root.has-project && !root.recording;
                            placeholder-text: root.has-project ? "" : "No project";
                            text <=> root.project-name;
                            accepted(name) => {
                                root.rename-project(name);
                                keys.focus();
                            }
                            // Accepting or leaving the field shows the saved
                            // name, so an empty, unchanged or abandoned edit
                            // doesn't linger.
                            changed has-focus => {
                                if (!self.has-focus) {
                                    root.project-name = root.saved-project-name;
                                }
                            }
                        }

                        Text {
                            text: "Sources";
                            color: Palette.alternate-foreground;
                            font-size: 11px;
                        }

                        ListView {
                            for source[index] in root.sources: Rectangle {
                                height: 48px;
                                background: drop.has-drag ? Palette.selection-background : transparent;
                                border-radius: 4px;

                                drop := DropArea {
                                    enabled: !root.recording;
                                    can-drop(event) => {
                                        root.dropped-index("sources", event.data) >= 0 ? DragAction.move : DragAction.none
                                    }
                                    dropped(event) => {
                                        root.move-source(root.dropped-index("sources", event.data), index);
                                        DragAction.move
                                    }

                                    DragArea {
                                        enabled: !root.recording;
                                        allow-move: true;
                                        data: root.drag-payload("sources", index);

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 2px;
                                            spacing: 6px;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;

                                                Text {
                                                    text: source.name;
                                                    color: Palette.foreground;
                                                    overflow: elide;
                                                }

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: source.duration;
                                                        color: Palette.alternate-foreground;
                                                        font-size: 11px;
                                                    }
                                                    if source.missing: Text {
                                                        text: "Missing";
                                                        color: #ff6b6b;
                                                        font-size: 11px;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "×";
                                                    accessible-label: "Remove";
                                                    enabled: !source.referenced && !root.recording;
                                                    clicked => {
                                                        root.remove-source(index);
                                                    }

                                                    Tooltip {
                                                        text: source.referenced
                                                            ? @markdown("Used by a clip or match event. Delete those first.")
                                                            : @markdown("Remove from the project");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "Clips";
                                color: Palette.alternate-foreground;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Sort by position";
                                enabled: root.clip-count >= 2 && !root.recording;
                                clicked => { root.sort-clips(); }

                                Tooltip {
                                    text: @markdown("Order the clips by where they start in the match");
                                }
                            }
                        }

                        // The overview's filter (C8), cleared by a click.
                        if root.tag-filter != "": Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: chip-touch.has-hover ? Palette.selection-background : Palette.control-background;

                            chip-touch := TouchArea {
                                clicked => { root.tag-filter = ""; }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;

                                Text {
                                    text: "Filtered: " + root.tag-filter;
                                    color: Palette.foreground;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "✕";
                                    color: Palette.alternate-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.tag-filter != "" && root.clips.length == 0: Text {
                            text: "No clips tagged '" + root.tag-filter + "'";
                            color: Palette.alternate-foreground;
                            wrap: word-wrap;
                        }

                        // Phase 3 C9. A click selects (never toggles: a
                        // double-click is two clicks first), a double-click
                        // jumps, a right-click opens the row's own menu without
                        // selecting, and a drag reorders. All off while
                        // recording, which the bus refuses. No drag while
                        // filtered: a filtered row's index isn't its place in
                        // the full order.
                        ListView {
                            for clip[index] in root.clips: Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: clip-drop.has-drag || clip.id == root.selected-clip
                                    ? Palette.selection-background
                                    : transparent;

                                clip-drop := DropArea {
                                    enabled: !root.recording && root.tag-filter == "";
                                    can-drop(event) => {
                                        root.dropped-index("clips", event.data) >= 0 ? DragAction.move : DragAction.none
                                    }
                                    dropped(event) => {
                                        root.move-clip(root.dropped-index("clips", event.data), index);
                                        DragAction.move
                                    }

                                    DragArea {
                                        enabled: !root.recording && root.tag-filter == "";
                                        allow-move: true;
                                        data: root.drag-payload("clips", index);

                                        TouchArea {
                                            enabled: !root.recording;
                                            clicked => {
                                                root.selected-clip = clip.id;
                                                // Off any field, so the keys work.
                                                keys.focus();
                                            }
                                            double-clicked => {
                                                root.jump-to-clip(clip.id);
                                            }
                                        }

                                        ContextMenuArea {
                                            enabled: !root.recording;
                                            Menu {
                                                MenuItem {
                                                    title: "Jump to clip start";
                                                    activated => { root.jump-to-clip(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Preview clip";
                                                    enabled: root.can-preview;
                                                    activated => { root.open-preview(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Export video…";
                                                    enabled: !root.exporting && !root.previewing;
                                                    activated => { root.export-clip(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Delete clip";
                                                    activated => { root.delete-clip(clip.id); }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 8px;

                                            Text {
                                                text: clip.name;
                                                color: root.recording ? Palette.alternate-foreground : Palette.foreground;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: clip.duration;
                                                color: Palette.alternate-foreground;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Player area: black, the picture fitted, zoomed and
                // panned (spec D9) ---
                player := Rectangle {
                    /// The zoom the picture is drawn at: identity while
                    /// previewing (P6), since the preview's texture already
                    /// has the coach's zoom baked in and the scan-time
                    /// transform would apply it twice. The window's `zoom` is
                    /// left alone, so closing the preview restores the view.
                    property <ZoomState> shown-zoom: root.previewing ? { scale: 1, pan-x: 0, pan-y: 0 } : root.zoom;
                    property <PictureRect> picture: root.place-picture(self.shown-zoom, root.frame-width, root.frame-height, self.width, self.height);
                    // The letterboxed rect at 1×. The zoomed picture is clipped
                    // to it, not to the whole player area, so the view is
                    // exactly the crop export produces (spec D9: one
                    // `Zoom::transform`) and the letterbox bars stay black at
                    // any zoom. Phase 6 strokes are normalized to this rect too.
                    property <PictureRect> content: root.place-picture({ scale: 1, pan-x: 0, pan-y: 0 }, root.frame-width, root.frame-height, self.width, self.height);

                    background: black;
                    clip: true;

                    // Off any field (C6), with nothing to zoom; `zoom-area`
                    // does it otherwise.
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    Rectangle {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        clip: true;

                        // Drawn at 1× size and scaled up by a transform, rather
                        // than sized to `picture`: Skia rounds a translate-only
                        // image's origin to whole pixels, so a slow pan would
                        // step 1 px at a time. With a scale in the transform it
                        // moves smoothly. (At 1× nothing pans, so the rounding
                        // left there is harmless.) Same rect either way.
                        // Coordinates are relative to the content rect.
                        Image {
                            source: root.frame;
                            x: player.picture.x - player.content.x;
                            y: player.picture.y - player.content.y;
                            width: player.picture.width / player.shown-zoom.scale;
                            height: player.picture.height / player.shown-zoom.scale;
                            transform-origin: { x: 0, y: 0 };
                            transform-scale: player.shown-zoom.scale;
                            image-fit: fill;
                        }

                        // The live telestration layer (D5), above the picture
                        // and clipped with it. Strokes are drawn where they
                        // were made, on the zoomed picture as seen, so they
                        // don't move with the zoom.
                        //
                        // Hidden while previewing (P6): the preview's texture
                        // already has the clip's drawings rasterized into it,
                        // and whatever is still on screen from scanning
                        // belongs to the game video, not to the clip.
                        if !root.previewing: Rectangle {
                            for cmds in root.live-paths: StrokePath {
                                commands: cmds;
                            }
                            // The one under the pen. An empty `commands` draws
                            // nothing, so it needs no `if`.
                            StrokePath {
                                commands: root.drawing-path;
                            }
                        }
                    }

                    zoom-area := TouchArea {
                        // Only over a picture: the empty-state cards cover it
                        // otherwise. Off while previewing, which is at
                        // identity zoom (P6).
                        enabled: root.can-play && !root.previewing;
                        scroll-event(event) => {
                            root.zoom-scroll(self.mouse-x, self.mouse-y, event.delta-x, event.delta-y, event.modifiers.control, event.modifiers.shift);
                            accept
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                keys.focus();
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.zoom-press(self.mouse-x, self.mouse-y);
                            }
                        }
                        // Only while a button is down; `pressed` is the primary one.
                        moved => {
                            if (self.pressed) {
                                root.zoom-drag(self.mouse-x, self.mouse-y);
                            }
                        }
                    }

                    ZoomIndicator {
                        x: (parent.width - self.width) / 2;
                        y: 12px;
                        // Identity while previewing, where it hides itself.
                        scale: player.shown-zoom.scale;
                        notches: root.zoom-notches;
                    }

                    if !root.has-project: EmptyCard {
                        title: "No project open";
                        message: "Open a folder to start scanning match footage. Coach Cuts keeps its project file (project.json) inside the folder.";
                        action: "Open Project…";
                        clicked => { root.open-project(); }
                    }
                    if root.has-project && root.sources.length == 0: EmptyCard {
                        title: "No source video added";
                        message: "Add the match video you want to scan. Several videos (for example two halves) play as one timeline.";
                        action: "Add Source Video…";
                        clicked => { root.add-source(); }
                    }
                    if root.has-project && root.sources.length > 0 && root.missing-index >= 0: EmptyCard {
                        title: "Source video is missing: " + root.missing-name;
                        message: "Coach Cuts can't find this video. It may have been moved, renamed or deleted. Pick its current location to continue.";
                        action: "Relink…";
                        // The bus refuses it while recording (R6's guard).
                        enabled: !root.recording;
                        clicked => { root.relink-source(root.missing-index); }
                    }

                    // --- Drawing (Phase 6 D1) ---
                    // The player's LAST child: Slint visits children front to
                    // back and a TouchArea grabs the pointer on press, so
                    // declared any earlier the presses would go to `zoom-area`
                    // and pan instead. Sized to the content rect, so a press
                    // in the letterbox bars still pans, and `mouse-x/y` are
                    // already content-relative.
                    //
                    // It accepts no scroll event, so wheels fall through to
                    // `zoom-area` behind it and pan and Ctrl-zoom keep
                    // working. Disabled it forwards everything and shows no
                    // cursor of its own.
                    TouchArea {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        enabled: root.can-draw;
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            // Slint drops the grab and sends a cancel when a
                            // grabbing area sees an exit or is disabled
                            // mid-stroke — the recording stopping, say. It
                            // carries `button: other`, so it has to come
                            // before the test below, or the stroke would be
                            // left on screen and never logged.
                            if (event.kind == PointerEventKind.cancel) {
                                root.draw-cancel();
                                return;
                            }
                            if (event.button != PointerEventButton.left) {
                                return;
                            }
                            if (event.kind == PointerEventKind.down) {
                                keys.focus();
                                root.draw-press(self.mouse-x, self.mouse-y);
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.draw-release(self.mouse-x, self.mouse-y);
                            }
                        }
                        // Only while a button is down; `pressed` is the
                        // primary one. The pointer is grabbed on press, so
                        // this keeps arriving off the picture; the stroke
                        // clamps to the edge.
                        moved => {
                            if (self.pressed) {
                                root.draw-move(self.mouse-x, self.mouse-y);
                            }
                        }
                    }
                }

                // --- Inspector: the selected clip, else the tag overview
                // (C7, C8) ---
                Rectangle {
                    width: 280px;
                    background: Palette.alternate-background;

                    // Empty space: off any field (C6).
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    // Hidden rather than removed, so `editing` always binds.
                    inspector := Inspector {
                        visible: root.selected-clip != "";
                        enabled: !root.recording;
                        name-text <=> root.clip-name;
                        tags-text <=> root.clip-tags;
                        notes-text <=> root.clip-notes;
                        show-pip <=> root.clip-show-pip;
                        begin-edit => { root.editing-clip-id = root.selected-clip; }
                        commit(field, text) => { root.edit-clip(root.editing-clip-id, field, text); }
                        end-edit(field, text) => {
                            let id = root.editing-clip-id;
                            // Unless focus moved to another field, which
                            // goes on editing the same clip.
                            if (!self.editing) {
                                root.editing-clip-id = "";
                            }
                            root.edit-clip(id, field, text);
                        }
                        can-preview: root.can-preview;
                        previewing: root.previewing && root.previewing-clip == root.selected-clip;
                        // The selection, since a click doesn't take focus
                        // from a field.
                        pip-toggled(on) => { root.set-show-pip(root.selected-clip, on); }
                        preview-clicked => {
                            keys.focus();
                            if (self.previewing) {
                                root.close-preview();
                            } else {
                                root.open-preview(root.selected-clip);
                            }
                        }
                        suggest-tags(text) => { return root.suggest-tags(text); }
                        take-suggestion(text, tag) => { return root.take-suggestion(text, tag); }
                    }
                    if root.selected-clip == "": TagOverview {
                        rows: root.tag-rows;
                        clip-count: root.clip-count;
                        filter <=> root.tag-filter;
                    }
                }
            }

            // --- Transport bar: the scrubber on a row of its own, full width,
            // with the controls under it ---
            Rectangle {
                background: Palette.alternate-background;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    Slider {
                        enabled: root.can-scrub;
                        minimum: 0;
                        maximum: max(root.total-seconds, 0.001);
                        value <=> root.position-seconds;
                        changed(value) => {
                            root.scrubbing = true;
                            root.scrub-move(value);
                        }
                        released(value) => {
                            root.scrubbing = false;
                            root.scrub-release(value);
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Button {
                            text: "Open Project…";
                            enabled: !root.recording;
                            clicked => { root.open-project(); }
                        }
                        Button {
                            text: "Add Source Video…";
                            enabled: root.has-project && !root.recording;
                            clicked => { root.add-source(); }
                        }
                        Button {
                            text: root.playing ? "Pause" : "Play";
                            enabled: root.can-play;
                            min-width: 72px;
                            clicked => { root.toggle-play(); }
                        }
                        Button {
                            text: root.recording ? "Stop" : "Record";
                            enabled: (root.can-play && !root.exporting && !root.previewing) || root.recording;
                            min-width: 72px;
                            // Off any field first: a click doesn't take focus
                            // from one, and a field disabled while it has
                            // focus would keep blocking the recording keys.
                            clicked => {
                                keys.focus();
                                root.toggle-recording();
                            }

                            Tooltip {
                                text: root.recording
                                    ? @markdown("Stop recording (R or Esc)")
                                    : root.exporting
                                        ? @markdown("Not while exporting")
                                        : root.previewing
                                            ? @markdown("Not while previewing a clip")
                                            : @markdown("Record (R)");
                            }
                        }
                        // Drawing's two controls (D6). Always mounted, and
                        // only disabled off a recording: mounting them with
                        // the recording would change the player's height,
                        // and with it the content rect strokes are
                        // normalized against. macOS learned this one.
                        VerticalLayout {
                            alignment: center;
                            CheckBox {
                                text: "Auto-clear";
                                enabled: root.can-draw;
                                checked <=> root.auto-clear;
                            }
                        }
                        Button {
                            text: "Clear";
                            enabled: root.can-draw;
                            clicked => {
                                keys.focus();
                                root.clear-drawings();
                            }

                            Tooltip {
                                text: @markdown("Clear the drawings (C)");
                            }
                        }
                        if root.recording-phase == RecordingPhase.starting: Text {
                            text: "Preparing recording…";
                            color: Palette.alternate-foreground;
                            vertical-alignment: center;
                        }
                        if root.recording-phase == RecordingPhase.recording: HorizontalLayout {
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: #ff3b30;
                                }
                            }
                            Text {
                                text: "Recording";
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.recording-elapsed;
                                color: Palette.foreground;
                                font-family: "monospace";
                                vertical-alignment: center;
                                min-width: 48px;
                            }
                            if !root.level-seen: Text {
                                text: "Waiting for audio…";
                                color: Palette.alternate-foreground;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            if root.level-seen: VerticalLayout {
                                alignment: center;
                                // The mic's peak over −60…0 dBFS.
                                Rectangle {
                                    width: 90px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #ffffff26;

                                    Rectangle {
                                        x: 0;
                                        width: parent.width * root.level;
                                        border-radius: 3px;
                                        background: root.level > 0.95 ? #ff3b30 : #34c759;
                                    }
                                }
                            }
                        }
                        // Its own item, so a notice can't overwrite it (P6).
                        // The transport above drives the preview while it's
                        // up, over the clip's own duration.
                        if root.previewing: HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "Previewing " + root.previewing-name;
                                color: Palette.foreground;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: center;
                                max-width: 200px;
                            }
                            Button {
                                text: "Close";
                                clicked => {
                                    keys.focus();
                                    root.close-preview();
                                }

                                Tooltip {
                                    text: @markdown("Close the preview and go back to the game video (Esc)");
                                }
                            }
                        }
                        // Its own item, so a notice can't overwrite it.
                        if root.exporting: HorizontalLayout {
                            spacing: 6px;

                            // Wide enough for 100%, so the row doesn't
                            // shift as it counts.
                            Text {
                                text: "Exporting " + root.export-progress + "%";
                                color: Palette.foreground;
                                font-size: 11px;
                                vertical-alignment: center;
                                min-width: 84px;
                            }
                            VerticalLayout {
                                alignment: center;
                                ProgressIndicator {
                                    width: 70px;
                                    progress: root.export-progress / 100;
                                }
                            }
                            Button {
                                text: "Cancel";
                                clicked => { root.cancel-export(); }
                            }
                        }
                        // The one stretch item: it takes the row's slack, and
                        // elides rather than squeeze the controls.
                        Text {
                            text: root.notice;
                            color: #ffcc00;
                            font-size: 11px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0;
                        }
                        Text {
                            text: root.readout;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            min-width: 130px;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: "Volume";
                            color: Palette.alternate-foreground;
                            vertical-alignment: center;
                        }
                        Slider {
                            width: 100px;
                            minimum: 0;
                            maximum: 1;
                            value <=> root.volume;
                            changed(value) => { root.volume-changed(value); }
                            released(value) => { root.volume-released(value); }
                        }
                        Button {
                            text: "Devices…";
                            enabled: root.has-project && !root.recording;
                            clicked => {
                                root.list-devices();
                                devices-popup.show();
                            }
                        }
                    }
                }

                // The Devices popover: above the bar's right end, over the player.
                devices-popup := PopupWindow {
                    x: parent.width - self.width - 8px;
                    y: -self.height - 8px;
                    width: 300px;

                    Rectangle {
                        background: Palette.background;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 12px;

                            DeviceList {
                                title: "Camera";
                                rows: root.cameras;
                                chosen(node-name) => { root.choose-camera(node-name); }
                            }
                            DeviceList {
                                title: "Microphone";
                                rows: root.mics;
                                chosen(node-name) => { root.choose-mic(node-name); }
                            }
                        }
                    }
                }
            }
        }

        // --- Error dialog: modal over the whole window ---
        if root.error-message != "": Rectangle {
            background: #000000a0;

            // Swallows clicks meant for the window behind.
            TouchArea { }

            Rectangle {
                width: 440px;
                height: dialog.preferred-height;
                background: Palette.background;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;

                dialog := VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    Text {
                        text: root.error-message;
                        color: Palette.foreground;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: "OK";
                            primary: true;
                            clicked => {
                                root.error-message = "";
                                keys.focus();
                            }
                        }
                    }
                }
            }
        }
    }
}
