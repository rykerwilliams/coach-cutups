// The Coach Cuts window (spec D9, D10, D11): sidebar, player area with its
// zoom and empty-state cards, transport bar, error dialog, and the keyboard.
//
// Everything here is presentation. `src/main.rs` turns the callbacks into bus
// commands and feeds bus events back in through the `in` properties.

import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ProgressIndicator, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { Mark, Scrubber } from "scrubber.slint";

/// One row of the sidebar's Sources list.
export struct SourceRow {
    name: string,
    /// Already formatted.
    duration: string,
    missing: bool,
    /// Used by a clip, a match event or a highlight, so it can't be removed.
    referenced: bool,
}

/// One row of the sidebar's Clips list, in the project's order.
export struct ClipRow {
    /// The clip's UUID.
    id: string,
    /// "Untitled" for an empty name.
    name: string,
    /// The recording's length, already formatted.
    duration: string,
}

/// One row of the tag overview (Phase 3 C8).
export struct TagRow {
    tag: string,
    /// "3 clips · 1:24", already formatted.
    detail: string,
}

/// One row of the export sheet's target list (Phase 8 E8): all the clips, one
/// tag's, or the clip the sheet was opened on.
export struct TargetRow {
    label: string,
    /// "4 clips · 3:12", or "3 goals · 1:48" for the reel, already
    /// formatted.
    detail: string,
    /// Ticked to export. `src/main.rs` owns it — it holds the targets these
    /// rows stand for — so the sheet only reports a click.
    ticked: bool,
}

/// One row of the export sheet's run list: a target of the run in progress.
export struct RunRow {
    label: string,
    /// Whether this target is the one rendering: only then is there a bar.
    rendering: bool,
    /// How far it has got, 0..1. Meaningless unless `rendering`.
    progress: float,
    /// "Pending", "45%", "Done", "Cancelled" or "Failed".
    status: string,
}

/// One row of the Match panel's event list (Phase 9 S4).
export struct MatchRow {
    /// The event's UUID.
    id: string,
    /// Where it sits on the concat timeline, already formatted.
    time: string,
    /// "1H start", "Home goal", … — already formatted.
    label: string,
    /// A start/stop this format has no period for. It keeps its place; the
    /// scoreboard ignores it until the format grows or the back-anchor goes
    /// off, so the row says so rather than looking like every other one.
    role-less: bool,
    /// A goal's span in the reel, "−30 s / +6 s"; empty for anything but a
    /// goal, whose row is the only one with the reel's buttons (spec R3).
    reel-span: string,
}

/// A goal row's reel buttons (spec R3): set one end of the goal's span at the
/// scan position, or put it back to the default.
export enum ReelTrim {
    start-here,
    reset-start,
    end-here,
    reset-end,
}

/// What a tag key or one of the Match panel's buttons records (Phase 9 S4).
export enum MatchTag {
    home-goal,
    away-goal,
    start-stop,
}

/// The inspector's text fields, for `edit-clip`.
/// Which way `J`, `L` and the speed button move the scan speed (spec S1).
export enum ScanStep {
    faster,
    slower,
    cycle,
}

export enum ClipField {
    name,
    tags,
    notes,
    transcript,
}

/// The selected clip's transcription, as the bus publishes it (Phase 10 S5).
/// `idle` covers "never transcribed" and "ran and found nothing" alike:
/// `transcript-status` is the line that tells those two apart.
export enum TranscriptState {
    idle,
    queued,
    running,
    failed,
}

/// One row of the Devices popover's camera or microphone list.
export struct DeviceRow {
    /// PipeWire's `node.name`, the stored preference; empty for "System
    /// default".
    node-name: string,
    label: string,
    /// The project's current choice.
    chosen: bool,
}

/// The recording as the UI last heard it from the bus (Phase 4 R6).
export enum RecordingPhase {
    idle,
    /// Recording, but the camera hasn't delivered a frame yet.
    starting,
    recording,
}

/// Zoom and pan (spec D9), mirrored from the Rust side, which owns it.
export struct ZoomState {
    scale: float,
    pan-x: float,
    pan-y: float,
}

/// Where the picture is drawn in the player area.
export struct PictureRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

/// The zoom readout (spec D9, macOS `ZoomIndicator`): the scale over a
/// logarithmic track from 1× to 10×, with ticks at the snap notches. Hidden
/// at 1×, where there's nothing to read.
component ZoomIndicator inherits Rectangle {
    in property <float> scale;
    in property <[float]> notches;

    /// 1× is the left end, 10× the right: log10(scale).
    function track-x(scale: float) -> length {
        max(0, min(1, log(max(scale, 1), 10))) * track.width
    }

    width: row.preferred-width;
    height: row.preferred-height;
    background: #0000008c;
    border-radius: 6px;
    opacity: root.scale > 1 ? 1 : 0;
    animate opacity { duration: 180ms; easing: ease-out; }

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;

        Text {
            text: root.scale.to-fixed(2) + "×";
            color: white;
            font-size: 12px;
            font-weight: 600;
            font-family: "monospace";
            width: 56px;
            vertical-alignment: center;
        }

        track := Rectangle {
            width: 140px;
            height: 12px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 3px;
                border-radius: 1.5px;
                background: #ffffff40;
            }
            for notch in root.notches: Rectangle {
                x: root.track-x(notch) - 0.5px;
                y: (parent.height - self.height) / 2;
                width: 1px;
                height: 9px;
                background: #ffffff8c;
            }
            Rectangle {
                x: root.track-x(root.scale) - 4.5px;
                y: (parent.height - self.height) / 2;
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: white;
            }
        }
    }
}

/// A card over the player area: the next thing to do when there's nothing to
/// play.
component EmptyCard inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> action;
    in property <bool> enabled: true;
    callback clicked();

    background: black;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 40px;

        Text {
            text: root.title;
            color: white;
            font-size: 20px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            Text {
                text: root.message;
                color: #ffffffb3;
                wrap: word-wrap;
                horizontal-alignment: center;
                width: min(420px, root.width - 80px);
            }
        }

        HorizontalLayout {
            alignment: center;
            Button {
                text: root.action;
                primary: true;
                enabled: root.enabled;
                clicked => { root.clicked(); }
            }
        }
    }
}

/// A row of the Devices popover: the device, checked if it's the choice.
/// Clicking it picks it (and closes the popover).
component DeviceChoice inherits Rectangle {
    in property <string> label;
    in property <bool> chosen;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.selection-background : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 6px;

        Text {
            text: root.chosen ? "✓" : "";
            color: Palette.foreground;
            width: 14px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: Palette.foreground;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

/// One of the Devices popover's lists, under its title. Picking a row reports
/// its `node-name`.
component DeviceList inherits VerticalLayout {
    in property <string> title;
    in property <[DeviceRow]> rows;
    callback chosen(string);

    spacing: 4px;

    Text {
        text: root.title;
        color: Palette.alternate-foreground;
        font-size: 11px;
    }
    if root.rows.length == 0: Text {
        text: "Looking for devices…";
        color: Palette.alternate-foreground;
    }
    for row in root.rows: DeviceChoice {
        label: row.label;
        chosen: row.chosen;
        clicked => { root.chosen(row.node-name); }
    }
}

/// The Devices popover's Inset section (avatar spec G1): the project's avatar
/// image, or the camera when it has none.
///
/// There are no radio rows, because the image **is** the mode (B1): picking
/// one is what makes a take record commentary without a camera, and removing
/// it is what puts the camera back.
component InsetSection inherits VerticalLayout {
    /// The picked image, empty when there is none or its file has gone.
    in property <image> thumb;
    /// Its file name, empty when nothing is picked.
    in property <string> name;
    /// A name is stored but the file isn't beside `project.json` any more
    /// (A4), so the coach finds out before a take rather than after an export.
    in property <bool> missing;
    callback choose();
    callback remove();

    spacing: 4px;

    Text {
        text: "Inset";
        color: Palette.alternate-foreground;
        font-size: 11px;
    }
    HorizontalLayout {
        spacing: 8px;

        // Min and max, not `width`: a layout sets its children's size, and a
        // plain `width` here is overwritten with the row's.
        if root.name != "" && !root.missing: Image {
            source: root.thumb;
            min-width: 40px;
            max-width: 40px;
            min-height: 40px;
            max-height: 40px;
            image-fit: contain;
        }
        Text {
            text: root.name == "" ? "Camera — no avatar picked"
                : root.missing ? root.name + " is missing"
                : root.name;
            color: root.missing ? #ffcc00 : Palette.foreground;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        Button {
            text: "Choose…";
            clicked => { root.choose(); }
        }
        if root.name != "": Button {
            text: "Remove";
            clicked => { root.remove(); }
        }
    }
}

/// A caption over one of the inspector's fields.
component FieldLabel inherits Text {
    color: Palette.alternate-foreground;
    font-size: 11px;
}

/// The selected clip's fields (Phase 3 C7). The window renders them through
/// the `in-out` properties, and the fields report focus and commits; which
/// clip a commit is for is the window's business.
component Inspector inherits Rectangle {
    in property <bool> enabled;
    in-out property <string> name-text;
    in-out property <string> tags-text;
    in-out property <string> notes-text;
    in-out property <bool> show-pip;
    /// This clip was recorded with the project's avatar rather than a camera
    /// (avatar G3). One word of the checkbox above follows it; the property,
    /// the command and the undo are the one `show-pip` either way.
    in property <bool> avatar;
    /// The project's avatar image has gone (A4), which costs an avatar clip
    /// its inset. Said here so the coach is told before they export.
    in property <bool> avatar-missing;
    /// The commentary as words (Phase 10 S4), editable like any other field.
    in-out property <string> transcript-text;
    /// What the bus says about this clip's transcription (S5) ...
    in property <TranscriptState> transcript-state;
    /// ... and the line under the box that says it in words -- including the
    /// "no speech found" that an `idle` clip with an empty transcript may
    /// have earned. Empty when there is nothing to say.
    in property <string> transcript-status;
    /// The speech models on offer, in `transcript-model`'s order (Phase 10
    /// S3). `src/main.rs` owns the list: under
    /// `$COACH_CUTS_WHISPER_MODEL` it is the one model that variable names,
    /// and the picker is disabled.
    in property <[string]> transcript-models;
    /// Which one is chosen, as an index into `transcript-models`. **Two-way:**
    /// a one-way binding onto a ComboBox's `current-index` is overwritten the
    /// first time the coach opens it, and the readout then lies.
    in-out property <int> transcript-model;
    /// Whether the choice is the coach's to make -- false under
    /// `$COACH_CUTS_WHISPER_MODEL`, which runs what it points at whatever is
    /// picked.
    in property <bool> transcript-model-enabled;
    /// Empty, or -- when the chosen model isn't downloaded yet -- what the
    /// Transcribe button says instead: the download it starts first, and its
    /// size (Phase 11 S3). The button is the prompt; pressing it is the
    /// consent.
    in property <string> transcribe-download;
    /// A field has focus: the window's shortcuts yield to it. **Every** text
    /// field belongs here: miss one and typing in it makes Space start
    /// playback and `r` start a recording.
    out property <bool> editing: name.has-focus || tags.has-focus || notes.has-focus
        || transcript.has-focus;
    /// Preview is possible at all (Phase 7 P6): something to play, and
    /// neither recording nor exporting, both of which the bus refuses.
    in property <bool> can-preview;
    /// This clip is the one on screen, so the button closes it instead.
    in property <bool> previewing;
    /// The Preview button: open a preview of this clip, or close the one
    /// showing it. Opening is explicit (P5) -- Space plays the game video
    /// until a preview is open.
    callback preview-clicked();

    /// A field gained focus ...
    callback begin-edit();
    /// ... pressed Enter (a commit that keeps focus) ...
    callback commit(ClipField, string);
    /// ... or lost focus, which commits.
    callback end-edit(ClipField, string);
    callback pip-toggled(bool);
    /// Queue this clip's commentary for transcription (Phase 10 S6).
    callback transcribe-clicked();
    /// Stop the transcription running **and drop the queue behind it**.
    callback cancel-transcribe-clicked();
    /// A speech model was picked, by index into `transcript-models`.
    callback transcript-model-chosen(int);
    /// Existing tags to suggest for the tag field's text (C8).
    pure callback suggest-tags(string) -> [string];
    /// The tag field's text with the suggestion taken.
    pure callback take-suggestion(string, string) -> string;

    /// For the tag field's current fragment, from its last edit.
    property <[string]> suggestions;
    /// Esc closed them; the next edit reopens them.
    property <bool> suggestions-dismissed;
    property <bool> suggesting: tags.has-focus && root.suggestions.length > 0 && !root.suggestions-dismissed;

    function focus-changed(field: ClipField, focused: bool, text: string) {
        root.suggestions = [];
        if (focused) {
            root.begin-edit();
        } else {
            root.end-edit(field, text);
        }
    }

    /// Takes `tag` into the tag field, keeping focus, with the cursor at the
    /// end. It doesn't commit: Enter or leaving the field does.
    function take(tag: string) {
        root.tags-text = root.take-suggestion(root.tags-text, tag);
        root.suggestions = [];
        // Past the end, which clamps to it.
        tags.set-selection-offsets(2147483647, 2147483647);
    }

    layout := VerticalLayout {
        padding: 12px;
        spacing: 6px;

        FieldLabel { text: "Name"; }
        name := LineEdit {
            enabled: root.enabled;
            placeholder-text: "Untitled";
            text <=> root.name-text;
            accepted(text) => { root.commit(ClipField.name, text); }
            changed has-focus => { root.focus-changed(ClipField.name, self.has-focus, self.text); }
        }

        FieldLabel { text: "Tags"; }
        // A direct child of the layout, so its x and y place the suggestions.
        tags := LineEdit {
            enabled: root.enabled;
            placeholder-text: "Comma-separated";
            text <=> root.tags-text;
            accepted(text) => {
                root.suggestions = [];
                root.commit(ClipField.tags, text);
            }
            changed has-focus => { root.focus-changed(ClipField.tags, self.has-focus, self.text); }
            edited(text) => {
                root.suggestions-dismissed = false;
                root.suggestions = root.suggest-tags(text);
            }
            // Tab takes the top suggestion; Esc closes them. Otherwise Tab
            // moves focus on, and Esc bubbles to the window, which leaves the
            // field.
            key-pressed(event) => {
                if (root.suggesting && event.text == Key.Tab) {
                    root.take(root.suggestions[0]);
                    return accept;
                }
                if (root.suggesting && event.text == Key.Escape) {
                    root.suggestions-dismissed = true;
                    return accept;
                }
                reject
            }
        }

        CheckBox {
            text: root.avatar ? "Show avatar in export" : "Show webcam in export";
            enabled: root.enabled;
            checked <=> root.show-pip;
            toggled => { root.pip-toggled(self.checked); }
        }

        if root.avatar && root.avatar-missing: Text {
            text: "The project's avatar image is missing, so this clip exports with no inset.";
            color: #ffcc00;
            font-size: 11px;
            wrap: word-wrap;
        }

        FieldLabel { text: "Notes"; }
        notes := TextEdit {
            enabled: root.enabled;
            vertical-stretch: 1;
            // Still the field that takes this layout's slack, but no longer
            // the field that pays for all of it: with the transcript below
            // it, an unbounded `notes` collapses to nothing in a 700px
            // window and draws its text over its own caption. The Match
            // panel's event list under this column gives way instead, and it
            // scrolls.
            min-height: 64px;
            text <=> root.notes-text;
            changed has-focus => { root.focus-changed(ClipField.notes, self.has-focus, self.text); }
        }

        // The caption carries the actions, as the Clips list's and the Match
        // panel's do: this column is 280px of a window that may be only
        // 700px tall, and a row of its own for the buttons comes straight
        // out of the Notes box above.
        HorizontalLayout {
            spacing: 6px;
            FieldLabel {
                text: "Transcript";
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            // Which model runs (Phase 10 S3): `small.en` was measured at
            // 0.73x realtime on the reference laptop, so the speed it buys
            // is worth a control. A fixed width, because the row is the
            // tightest in the app and a long name from
            // `$COACH_CUTS_WHISPER_MODEL` must not push the button out of
            // a 1100px window.
            ComboBox {
                width: 96px;
                model: root.transcript-models;
                // Two-way, so the coach's pick stays on screen (a one-way
                // binding is dropped the first time the popup opens), and
                // `selected` is what tells Rust.
                current-index <=> root.transcript-model;
                enabled: root.enabled && root.transcript-model-enabled;
                selected => { root.transcript-model-chosen(self.current-index); }

                Tooltip {
                    text: root.transcript-model-enabled
                        ? @markdown("Which speech model transcribes: `base.en` is faster, `small.en` more accurate. The clip being transcribed keeps the model it started with.")
                        : @markdown("`$COACH_CUTS_WHISPER_MODEL` is set, so it is what runs.");
                }
            }
            // **One action, not two.** With the picker beside them, a
            // caption row of [Transcript] [model] [Transcribe] [Cancel] runs
            // 76px past this 280px column at the window's 1100x700 minimum,
            // and Cancel falls off the edge. They are never both live —
            // Transcribe is disabled exactly when Cancel is offered — so the
            // row shows the one that does something, and the line under the
            // box says which state that is.
            //
            // Cancel is beside a waiting clip as much as a running one: the
            // command stops the job in flight *and* drops the queue behind
            // it.
            if root.transcript-state == TranscriptState.queued
                || root.transcript-state == TranscriptState.running: Button {
                text: "Cancel";
                // `CancelTranscription` is not on the recording allow-list,
                // so a click through would be dropped with nothing to show
                // for it.
                enabled: root.enabled;
                clicked => { root.cancel-transcribe-clicked(); }

                Tooltip { text: @markdown("Stop transcribing, and drop what's waiting"); }
            }
            if root.transcript-state != TranscriptState.queued
                && root.transcript-state != TranscriptState.running
                && root.transcribe-download == "": Button {
                text: "Transcribe";
                enabled: root.enabled;
                clicked => { root.transcribe-clicked(); }

                Tooltip { text: @markdown("Write out the commentary recorded over this clip"); }
            }
        }
        // **The download's prompt is the button itself** (Phase 11 S3), and
        // on a row of its own: a caption row that fits "Transcribe" beside
        // the picker has no room for a size, and a prompt that ran off the
        // column's edge would hide the one number it exists to show. The
        // row is there only until the model is -- once, per model.
        if root.transcript-state != TranscriptState.queued
            && root.transcript-state != TranscriptState.running
            && root.transcribe-download != "": Button {
            text: root.transcribe-download;
            enabled: root.enabled;
            clicked => { root.transcribe-clicked(); }

            Tooltip { text: @markdown("The speech model isn't on this computer yet. It is downloaded once, then kept for every clip"); }
        }
        // A fixed height with its own scroll, deliberately: `notes` above
        // already takes this layout's slack, and a second stretchy box would
        // halve both of them.
        transcript := TextEdit {
            enabled: root.enabled;
            height: 88px;
            text <=> root.transcript-text;
            changed has-focus => { root.focus-changed(ClipField.transcript, self.has-focus, self.text); }
        }
        if root.transcript-status != "": Text {
            text: root.transcript-status;
            font-size: 11px;
            wrap: word-wrap;
            color: root.transcript-state == TranscriptState.failed
                ? #ff6b6b
                : Palette.alternate-foreground;
        }

        Button {
            text: root.previewing ? "Close Preview" : "Preview";
            primary: !root.previewing;
            // Closing is always possible; opening needs the bus to be idle.
            enabled: root.previewing || root.can-preview;
            clicked => { root.preview-clicked(); }

            Tooltip {
                text: root.previewing
                    ? @markdown("Close the preview (Esc)")
                    : @markdown("Play this clip as it was recorded");
            }
        }
    }

    // Over the fields below, not a `PopupWindow`, whose `show()` would take
    // focus from the field and commit it (C8).
    if root.suggesting: Rectangle {
        x: tags.x;
        y: tags.y + tags.height + 2px;
        width: tags.width;
        height: suggestion-list.preferred-height;
        background: Palette.background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border;

        suggestion-list := VerticalLayout {
            padding: 4px;

            for tag in root.suggestions: Rectangle {
                height: 26px;
                border-radius: 4px;
                background: suggestion-touch.has-hover ? Palette.selection-background : transparent;

                // A click doesn't take focus from the field.
                suggestion-touch := TouchArea {
                    clicked => { root.take(tag); }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: tag;
                        color: Palette.foreground;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

/// With nothing selected, the inspector's column lists the project's tags
/// (C8). Clicking one filters the Clips list by it, or clears that filter.
component TagOverview inherits VerticalLayout {
    in property <[TagRow]> rows;
    in property <int> clip-count;
    in-out property <string> filter;

    padding: 12px;
    spacing: 8px;

    FieldLabel { text: "Tags"; }
    if root.clip-count == 0: Text {
        text: "No clips yet";
        color: Palette.alternate-foreground;
    }
    if root.clip-count > 0 && root.rows.length == 0: Text {
        text: "No tags yet — add tags to a clip in the inspector.";
        color: Palette.alternate-foreground;
        wrap: word-wrap;
    }
    ListView {
        for row in root.rows: Rectangle {
            height: 40px;
            border-radius: 4px;
            background: row.tag == root.filter || tag-touch.has-hover ? Palette.selection-background : transparent;

            tag-touch := TouchArea {
                clicked => { root.filter = root.filter == row.tag ? "" : row.tag; }
            }
            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                spacing: 2px;

                Text {
                    text: row.tag;
                    color: Palette.foreground;
                    overflow: elide;
                }
                Text {
                    text: row.detail;
                    color: Palette.alternate-foreground;
                    font-size: 11px;
                }
            }
        }
    }
}

/// One of a goal row's reel buttons (spec R3): a glyph, as the row's other
/// buttons are, with its name for screen readers and a tooltip.
component ReelButton inherits VerticalLayout {
    in property <string> text;
    in property <string> name;
    in property <styled-text> tip;
    in property <bool> enabled;
    callback clicked();

    alignment: center;
    Button {
        text: root.text;
        width: 28px;
        accessible-label: root.name;
        enabled: root.enabled;
        clicked => { root.clicked(); }

        Tooltip {
            text: root.tip;
        }
    }
}

/// The Match panel (Phase 9 S4), under the inspector's column: the live score
/// and clock, the three tag actions the `z`, `x` and `v` keys also fire, and
/// the tagged events in match order with a seek and a delete each.
///
/// Everything it shows is rendered by `src/main.rs`: the rows from the
/// project, the score and clock from the scan anchor on the 30 Hz tick.
component MatchPanel inherits VerticalLayout {
    /// The project has teams. Without them there is no scoreboard to show,
    /// and the setup sheet is the way in.
    in property <bool> configured;
    /// "Rovers 2 – 1 United", or the two names before kick-off.
    in property <string> score;
    /// "45:00", "45:00 +2:13", "HT", "FT", or a dash before kick-off. Frozen
    /// while a preview is open, whose own scoreboard is in its picture.
    in property <string> clock;
    in property <[MatchRow]> rows;
    /// Tagging is possible: while scanning or recording, never while
    /// previewing or during a recording's start-up (spec S4).
    in property <bool> can-tag;
    /// Every period of the format is tagged already, so another start/stop
    /// would get no role: that action is off and the panel says why (S5).
    in property <bool> at-cap;
    /// A row's buttons: the bus refuses both a seek and a delete while
    /// recording, and the panel doesn't act on the game video behind a
    /// preview.
    in property <bool> can-edit;
    /// How many lines the list has, a goal's row being two: its height.
    in property <int> lines;
    callback tag(MatchTag);
    callback seek(string);
    callback remove(string);
    callback trim(string, ReelTrim);
    callback setup();

    padding: 12px;
    spacing: 6px;

    HorizontalLayout {
        spacing: 8px;
        FieldLabel {
            text: "Match";
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Button {
            text: root.configured ? "Setup…" : "Set up teams…";
            clicked => { root.setup(); }

            Tooltip {
                text: @markdown("Team names, colours and the match format");
            }
        }
    }

    if !root.configured: Text {
        text: "No teams yet. The clock and score are drawn into previews and exports once they're set up.";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }
    if root.configured: HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.score;
            color: Palette.foreground;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.clock;
            color: Palette.foreground;
            font-family: "monospace";
            vertical-alignment: center;
        }
    }

    Button {
        text: "Home goal  (Z)";
        enabled: root.can-tag;
        clicked => { root.tag(MatchTag.home-goal); }
    }
    Button {
        text: "Away goal  (X)";
        enabled: root.can-tag;
        clicked => { root.tag(MatchTag.away-goal); }
    }
    Button {
        text: "Start / stop  (V)";
        enabled: root.can-tag && !root.at-cap;
        clicked => { root.tag(MatchTag.start-stop); }
    }
    if root.at-cap: Text {
        text: "Every period of this format is tagged. Delete a start/stop, or change the format, to tag another.";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }

    FieldLabel { text: "Events"; }
    if root.rows.length == 0: Text {
        text: "Nothing tagged yet.";
        color: Palette.alternate-foreground;
        font-size: 11px;
    }
    // A height of its own, so a long match scrolls rather than pushing the
    // inspector out of the column.
    ListView {
        height: min(168px, root.lines * 28px);
        for row in root.rows: VerticalLayout {
            HorizontalLayout {
                height: 28px;
                spacing: 6px;

                Text {
                    text: row.time;
                    color: Palette.alternate-foreground;
                    font-family: "monospace";
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: row.label;
                    color: row.role-less ? Palette.alternate-foreground : Palette.foreground;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "→";
                        accessible-label: "Seek";
                        enabled: root.can-edit;
                        clicked => { root.seek(row.id); }

                        Tooltip {
                            text: @markdown("Play the game video from here");
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "×";
                        accessible-label: "Delete";
                        enabled: root.can-edit;
                        clicked => { root.remove(row.id); }

                        Tooltip {
                            text: @markdown("Delete this event (undoable)");
                        }
                    }
                }
            }
            // A goal's reel span (R3), on a line of its own: the column has
            // no room for it beside the row. The buttons are glyphs, as the
            // row's are, with their names in the tooltips.
            if row.reel-span != "": HorizontalLayout {
                height: 28px;
                spacing: 4px;

                Text {
                    text: "Reel " + row.reel-span;
                    color: Palette.alternate-foreground;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                ReelButton {
                    text: "⇤";
                    name: "Reel starts here";
                    tip: @markdown("Reel starts here: the goal's entry begins at this frame");
                    enabled: root.can-edit;
                    clicked => { root.trim(row.id, ReelTrim.start-here); }
                }
                ReelButton {
                    text: "↺";
                    name: "Reset reel start";
                    tip: @markdown("Reset the reel start to the default");
                    enabled: root.can-edit;
                    clicked => { root.trim(row.id, ReelTrim.reset-start); }
                }
                ReelButton {
                    text: "⇥";
                    name: "Reel ends here";
                    tip: @markdown("Reel ends here: the goal's entry stops at this frame");
                    enabled: root.can-edit;
                    clicked => { root.trim(row.id, ReelTrim.end-here); }
                }
                ReelButton {
                    text: "↺";
                    name: "Reset reel end";
                    tip: @markdown("Reset the reel end to the default");
                    enabled: root.can-edit;
                    clicked => { root.trim(row.id, ReelTrim.reset-end); }
                }
            }
        }
    }
}

/// One player highlight in the Highlights panel (spec H3): its id, the
/// colour its ring is drawn in and the label on its pill.
export struct HighlightRow {
    id: string,
    ink: color,
    label: string,
}

/// The Highlights panel (spec H3), under the Match panel: the ringed players
/// on the footage, with the selected one's label, its keys and a delete.
///
/// Everything it acts on goes through the bus, as the Match panel's rows do.
/// Its edits are off while recording, where only *placing* a key is allowed:
/// a coach mid-take can mark a player but not recolour or delete one.
component HighlightsPanel inherits VerticalLayout {
    in property <[HighlightRow]> rows;
    /// The selected highlight's id, empty for none. A drag on a ring selects
    /// it, and so does a click on a row.
    in property <string> selected;
    // Selecting another row removes the field under this one, and Slint does
    // not promise a focus-change callback from an element it has destroyed:
    // without this the window's shortcuts could stay switched off for good.
    changed selected => { root.label-focused = false; }
    /// The H tool is on, which is what the panel tells the coach how to use.
    in property <bool> tool-on;
    /// Edits are possible: not while recording, and not with nothing loaded.
    in property <bool> can-edit;
    /// The displayed frame carries one of the selected highlight's keys, so
    /// "Delete key here" has something to remove.
    in property <bool> key-here;
    /// The selected highlight's label, two-way as the inspector's fields are:
    /// a `text:` binding breaks the first time it's typed in.
    in-out property <string> label-text;
    /// The field has focus: the window's shortcuts yield to it. Read off a
    /// property the field sets rather than off the field itself, which lives
    /// inside the row loop and so has no name out here — and `and`ed with the
    /// selection, so a highlight deleted while its label had focus can't
    /// leave the shortcuts switched off.
    out property <bool> editing: root.selected != "" && root.label-focused;
    property <bool> label-focused;

    callback select(string);
    callback remove(string);
    /// "Delete key here": the key on the frame on screen.
    callback delete-key(string);
    callback begin-edit();
    callback commit(string);
    callback end-edit(string);

    padding: 12px;
    spacing: 6px;

    FieldLabel { text: "Highlights"; }

    if root.rows.length == 0: Text {
        text: root.tool-on
            ? "Pause the game video and drag a box around a player."
            : "Press H, pause, and drag a box around a player to ring them.";
        color: Palette.alternate-foreground;
        font-size: 11px;
        wrap: word-wrap;
    }

    for row in root.rows: VerticalLayout {
        spacing: 4px;

        Rectangle {
            height: 28px;
            border-radius: 4px;
            background: row.id == root.selected ? Palette.selection-background : transparent;

            // The whole row selects; the delete button in front takes its
            // own clicks.
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.select(row.id); }
            }

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: row.ink;
                        // The strokes' own dark edge, so white and yellow hold.
                        border-width: 1px;
                        border-color: #00000066;
                    }
                }
                Text {
                    text: row.label == "" ? "Unlabelled" : row.label;
                    color: row.label == "" ? Palette.alternate-foreground : Palette.foreground;
                    font-size: 11px;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "×";
                        accessible-label: "Delete";
                        enabled: root.can-edit;
                        clicked => { root.remove(row.id); }

                        Tooltip {
                            text: @markdown("Delete this highlight (undoable)");
                        }
                    }
                }
            }
        }

        // The selected row's own controls: the label its pill shows, and the
        // key on the frame the coach is looking at.
        if row.id == root.selected: VerticalLayout {
            spacing: 4px;

            LineEdit {
                enabled: root.can-edit;
                placeholder-text: "Shirt number or name";
                text <=> root.label-text;
                accepted(text) => { root.commit(text); }
                changed has-focus => {
                    root.label-focused = self.has-focus;
                    if (self.has-focus) {
                        root.begin-edit();
                    } else {
                        root.end-edit(self.text);
                    }
                }
            }
            Button {
                text: "Delete key here";
                enabled: root.can-edit && root.key-here;
                clicked => { root.delete-key(row.id); }

                Tooltip {
                    text: @markdown("Remove this player's key on the frame on screen. Their last key deletes the highlight.");
                }
            }
        }
    }
}

/// A live stroke: its commands, in the content rect's logical pixels, and
/// the colour of the pen it was drawn with.
export struct LiveStroke {
    commands: string,
    ink: color,
}

/// One player highlight on the live picture (spec H5), as
/// `src/highlight_view.rs` builds it: the ring's commands and the pill's
/// anchor, both in content-rect logical pixels.
export struct LiveHighlight {
    commands: string,
    ink: color,
    label: string,
    label-ink: color,
    label-x: length,
    label-y: length,
    font-size: length,
    label-pad: length,
    pill-height: length,
}

/// One pass of a live telestration stroke (Phase 6 D5). Its `commands` are in
/// the content rect's logical pixels, which `fit: preserve` takes as they
/// are: it short-circuits before any bounding-box or stroke-width fitting, so
/// no viewbox is needed.
///
/// `fill` stays unset on purpose: a fill on an open polyline fills the area
/// the line encloses.
component StrokePass inherits Path {
    width: 100%;
    height: 100%;
    fit: preserve;
    // Round caps also make a single point (`M x y L x y`) a dot.
    stroke-line-cap: round;
    stroke-line-join: round;
}

/// One live stroke, on the thin dark edge export and preview draw under it
/// (the overlay's `draw_strokes`): the edge, then the line over it, so only
/// the edge's rim shows. The caller sets `commands` and `ink`.
component StrokePath inherits Rectangle {
    in property <string> commands;
    in property <color> ink;
    /// `core::layout::STROKE_LINE_WIDTH`, a fraction of the picture's height:
    /// the one pen width, handed in from Rust rather than written here, so a
    /// live line is exactly the line export burns in. `root` is the content
    /// rect, by the 100% below.
    in property <float> line-width;
    width: 100%;
    height: 100%;

    // Exactly the overlay's `STROKE_EDGE_RATIO` (a quarter of the line a
    // side, so 1.5 lines across) and `STROKE_EDGE_ALPHA` (black at 80%).
    StrokePass {
        commands: root.commands;
        stroke: #000000cc;
        stroke-width: root.height * root.line-width * 1.5;
    }
    StrokePass {
        commands: root.commands;
        stroke: root.ink;
        stroke-width: root.height * root.line-width;
    }
}

/// A player highlight's label on the live picture: a pill of the highlight's
/// own colour (spec H4), centred on `anchor-x` and with its top at
/// `anchor-y`.
///
/// **Everything but the width is decided in Rust** — the font, the padding,
/// the pill's height, its y (above the box, or below it where there is no
/// room) and the ink that can be read on it all arrive as properties from
/// `core::highlight`'s shape, which is what the export overlay draws from
/// too. The width is the one thing only a text shaper knows, so it is settled
/// here and the x clamped here, where it is finally known: a ring at either
/// edge keeps its number on the picture instead of half of it. The overlay's
/// pill may come out a pixel or two wider — a different shaper — and that is
/// fine, since the number sits in the same place either way.
component HighlightLabel inherits Rectangle {
    in property <string> label;
    in property <color> ink;
    in property <color> label-ink;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> font-size;
    in property <length> label-pad;
    in property <length> pill-height;
    /// The content rect's width, which is what the pill is kept inside.
    in property <length> content-width;

    visible: root.label != "";
    x: max(0px, min(root.anchor-x - self.width / 2, root.content-width - self.width));
    y: root.anchor-y;
    width: line.width + root.label-pad * 2;
    height: root.pill-height;
    border-radius: self.height / 2;
    background: root.ink;

    line := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        font-size: root.font-size;
        font-weight: 700;
        color: root.label-ink;
    }
}

/// A row of the export sheet's target list: its tick, what it covers and how
/// long that runs. A click anywhere on the row ticks or unticks it.
component TargetChoice inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> ticked;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    border-radius: 4px;
    background: root.enabled && touch.has-hover ? Palette.selection-background : transparent;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 15px;
                height: 15px;
                border-radius: 3px;
                border-width: 1px;
                border-color: Palette.border;
                background: root.ticked ? Palette.accent-background : transparent;

                Text {
                    text: root.ticked ? "✓" : "";
                    color: Palette.accent-foreground;
                    font-size: 11px;
                }
            }
        }
        Text {
            text: root.label;
            color: root.enabled ? Palette.foreground : Palette.alternate-foreground;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.detail;
            color: Palette.alternate-foreground;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

/// The export sheet (Phase 8 E8), the **only** export UI: what to render, at
/// what size and quality, and how the run is going. The window opens it; it
/// reports ticks, Export, Cancel and Close.
///
/// A run goes on behind a closed sheet, and reopening it shows where that run
/// has got to: the rows come from the bus's events, not from the sheet.
component ExportSheet inherits Rectangle {
    in property <[TargetRow]> targets;
    /// Something is ticked, so there is something to export.
    in property <bool> any-ticked;
    /// The run in progress, one row per target; empty before the first.
    in property <[RunRow]> run;
    /// "Finishes at 3:42 PM", empty until the rate is steady (spec E5).
    in property <string> finish;
    /// A run is going: the targets and the pickers are settled for it.
    in property <bool> exporting;
    /// 720p or 1080p, and Low / Medium / High: the pickers' indices.
    in-out property <int> resolution;
    in-out property <int> quality;
    /// How the scoreboard is carried: 0 Default (the target's own), 1 burned
    /// into the picture, 2 a separate track (spec M1).
    in-out property <int> scoreboard;
    /// The whole match is ticked, and so the run may copy rather than
    /// re-encode. `src/main.rs` owns it, beside the ticks themselves.
    in property <bool> whole-match-ticked;
    callback tick(int, bool);
    callback start();
    callback cancel();
    callback close();

    width: 480px;
    height: sheet.preferred-height;
    background: Palette.background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;

    sheet := VerticalLayout {
        padding: 20px;
        spacing: 10px;

        Text {
            text: "Export";
            color: Palette.foreground;
            font-size: 16px;
            font-weight: 600;
        }

        FieldLabel { text: "What to export"; }
        // A height of its own: a project with many tags scrolls the list
        // rather than growing the sheet past the window.
        ListView {
            height: min(210px, max(30px, root.targets.length * 30px));
            for row[index] in root.targets: TargetChoice {
                label: row.label;
                detail: row.detail;
                ticked: row.ticked;
                enabled: !root.exporting;
                clicked => { root.tick(index, !row.ticked); }
            }
        }

        HorizontalLayout {
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;
                FieldLabel { text: "Resolution"; }
                ComboBox {
                    // 2160p is in the project format but not offered (E8).
                    model: ["720p", "1080p"];
                    enabled: !root.exporting;
                    current-index <=> root.resolution;
                }
            }
            VerticalLayout {
                spacing: 4px;
                FieldLabel { text: "Quality"; }
                ComboBox {
                    model: ["Low", "Medium", "High"];
                    enabled: !root.exporting;
                    current-index <=> root.quality;
                }
            }
        }

        // Its own row rather than a third column: "Burned into the picture"
        // doesn't fit a third of this sheet.
        VerticalLayout {
            spacing: 4px;
            FieldLabel { text: "Scoreboard"; }
            ComboBox {
                model: ["Default", "Burned into the picture", "Separate track"];
                enabled: !root.exporting;
                current-index <=> root.scoreboard;
            }
            // The only place the trade is spelled out, and it follows the
            // **effective** mode rather than the picked one: the whole match
            // is copied on Default too, and a coach told nothing has taken
            // the trade without being asked (spec M1, N). Only the whole
            // match is ever copied, so only its tick matters here.
            if root.whole-match-ticked && root.scoreboard != 1: Text {
                text: "The whole match is copied, not re-encoded: player highlights and pen drawings can't ride a copy.";
                color: Palette.alternate-foreground;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        if root.run.length > 0: FieldLabel { text: "Run"; }
        if root.run.length > 0: ListView {
            height: min(140px, root.run.length * 28px);
            for row in root.run: HorizontalLayout {
                height: 28px;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;

                Text {
                    text: row.label;
                    color: Palette.foreground;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // Only while it renders; the status word stands in otherwise.
                if row.rendering: VerticalLayout {
                    alignment: center;
                    ProgressIndicator {
                        width: 120px;
                        progress: row.progress;
                    }
                }
                Text {
                    text: row.status;
                    color: Palette.alternate-foreground;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 64px;
                }
            }
        }
        // The one rendering of the estimate (E5): when the run ends, not how
        // much of it is left.
        if root.finish != "": Text {
            text: root.finish;
            color: Palette.alternate-foreground;
            font-size: 11px;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            if root.exporting: Button {
                text: "Cancel export";
                clicked => { root.cancel(); }

                Tooltip {
                    text: @markdown("Stop the run. The videos already written are kept.");
                }
            }
            Button {
                text: "Close";
                clicked => { root.close(); }
            }
            if !root.exporting: Button {
                text: "Export";
                primary: true;
                enabled: root.any-ticked;
                clicked => { root.start(); }
            }
        }
    }
}

/// One field of the match setup sheet: its caption, a mark when what's typed
/// isn't something the sheet can save, and the swatch a colour field shows.
///
/// The text is two-way bound all the way out to the window's property: a
/// `text:` binding breaks the moment the user types into it.
component SetupField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> ok: true;
    /// A colour field shows what its text parses to, beside the caption.
    in property <bool> has-swatch;
    in property <color> swatch;
    in-out property <string> text;

    spacing: 2px;

    HorizontalLayout {
        spacing: 4px;
        FieldLabel {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if !root.ok: Text {
            text: "✕";
            color: #ff6b6b;
            font-size: 11px;
            vertical-alignment: center;
        }
        if root.has-swatch: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 2px;
                border-width: 1px;
                border-color: Palette.border;
                background: root.swatch;
            }
        }
    }
    LineEdit {
        placeholder-text: root.placeholder;
        text <=> root.text;
    }
}

/// The match setup sheet (Phase 9 S4): both teams with their three colours,
/// the match format, and the back-anchor -- "my video starts after kick-off".
///
/// Colours are **hex fields**: Slint 1.18 has no colour picker, and the Mac's
/// inspector cell was effectively a field too. Nothing here is an undo step:
/// the sheet has Cancel, and the history is the coach's tagging (spec S5).
component MatchSetupSheet inherits Rectangle {
    in-out property <string> home-name;
    in-out property <string> home-primary;
    in-out property <string> home-secondary;
    in-out property <string> home-font;
    in-out property <string> away-name;
    in-out property <string> away-primary;
    in-out property <string> away-secondary;
    in-out property <string> away-font;
    in-out property <string> regulation-periods;
    in-out property <string> regulation-minutes;
    in-out property <string> overtime-periods;
    in-out property <string> overtime-minutes;
    in-out property <bool> back-anchor;
    /// The window's validators. They take the text so the bindings below
    /// re-evaluate on every keystroke.
    pure callback hex-color(string) -> color;
    pure callback valid-name(string) -> bool;
    pure callback valid-hex(string) -> bool;
    /// One per numeric field: each knows its own range, which lives in
    /// `match_panel.rs` beside the parse that builds the config, so a field
    /// can't be marked good and then refuse to save.
    pure callback valid-periods(string) -> bool;
    pure callback valid-overtime-periods(string) -> bool;
    pure callback valid-minutes(string) -> bool;
    /// The warning for start/stops the format being typed has no period for,
    /// empty when there are none. The back-anchor goes in because its derived
    /// start takes a period: ticking the box moves the warning.
    pure callback over-cap(string, string, bool) -> string;
    callback save();
    callback cancel();

    /// Every field good. The empty-name rule is the command's (S5); Save is
    /// off here so the coach isn't answered with a dialog on a name that is
    /// only spaces -- which is what the command sees, since the field's text
    /// is trimmed.
    property <bool> can-save:
        root.valid-name(root.home-name) && root.valid-name(root.away-name)
        && root.valid-hex(root.home-primary) && root.valid-hex(root.home-secondary)
        && root.valid-hex(root.home-font) && root.valid-hex(root.away-primary)
        && root.valid-hex(root.away-secondary) && root.valid-hex(root.away-font)
        && root.valid-periods(root.regulation-periods)
        && root.valid-minutes(root.regulation-minutes)
        && root.valid-overtime-periods(root.overtime-periods)
        && root.valid-minutes(root.overtime-minutes);
    property <string> orphaned:
        root.over-cap(root.regulation-periods, root.overtime-periods, root.back-anchor);

    width: 520px;
    height: sheet.preferred-height;
    background: Palette.background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;

    sheet := VerticalLayout {
        padding: 20px;
        spacing: 10px;

        Text {
            text: "Match setup";
            color: Palette.foreground;
            font-size: 16px;
            font-weight: 600;
        }

        HorizontalLayout {
            spacing: 16px;

            VerticalLayout {
                spacing: 6px;
                FieldLabel { text: "HOME TEAM"; }
                SetupField {
                    label: "Name";
                    placeholder: "Home";
                    ok: root.valid-name(root.home-name);
                    text <=> root.home-name;
                }
                SetupField {
                    label: "Primary";
                    has-swatch: true;
                    swatch: root.hex-color(root.home-primary);
                    ok: root.valid-hex(root.home-primary);
                    placeholder: "#rrggbb";
                    text <=> root.home-primary;
                }
                SetupField {
                    label: "Accent";
                    has-swatch: true;
                    swatch: root.hex-color(root.home-secondary);
                    ok: root.valid-hex(root.home-secondary);
                    placeholder: "#rrggbb";
                    text <=> root.home-secondary;
                }
                SetupField {
                    label: "Text";
                    has-swatch: true;
                    swatch: root.hex-color(root.home-font);
                    ok: root.valid-hex(root.home-font);
                    placeholder: "#rrggbb";
                    text <=> root.home-font;
                }
            }
            VerticalLayout {
                spacing: 6px;
                FieldLabel { text: "AWAY TEAM"; }
                SetupField {
                    label: "Name";
                    placeholder: "Away";
                    ok: root.valid-name(root.away-name);
                    text <=> root.away-name;
                }
                SetupField {
                    label: "Primary";
                    has-swatch: true;
                    swatch: root.hex-color(root.away-primary);
                    ok: root.valid-hex(root.away-primary);
                    placeholder: "#rrggbb";
                    text <=> root.away-primary;
                }
                SetupField {
                    label: "Accent";
                    has-swatch: true;
                    swatch: root.hex-color(root.away-secondary);
                    ok: root.valid-hex(root.away-secondary);
                    placeholder: "#rrggbb";
                    text <=> root.away-secondary;
                }
                SetupField {
                    label: "Text";
                    has-swatch: true;
                    swatch: root.hex-color(root.away-font);
                    ok: root.valid-hex(root.away-font);
                    placeholder: "#rrggbb";
                    text <=> root.away-font;
                }
            }
        }

        FieldLabel { text: "FORMAT"; }
        // Two rows of two: four fields abreast don't fit the sheet's width.
        HorizontalLayout {
            spacing: 16px;

            SetupField {
                label: "Periods";
                ok: root.valid-periods(root.regulation-periods);
                text <=> root.regulation-periods;
            }
            SetupField {
                label: "Minutes each";
                ok: root.valid-minutes(root.regulation-minutes);
                text <=> root.regulation-minutes;
            }
        }
        HorizontalLayout {
            spacing: 16px;

            SetupField {
                label: "Overtime periods";
                ok: root.valid-overtime-periods(root.overtime-periods);
                text <=> root.overtime-periods;
            }
            SetupField {
                label: "Minutes each";
                ok: root.valid-minutes(root.overtime-minutes);
                text <=> root.overtime-minutes;
            }
        }

        CheckBox {
            text: "My video starts after kick-off";
            checked <=> root.back-anchor;

            Tooltip {
                text: @markdown("The first period's start is derived, so tagging half-time puts the clock at the right minute. It takes the first period, so a fully-tagged format has one start/stop left over -- kept, but without a period until you untick this.");
            }
        }

        // The records are never dropped -- the cap is on what gets a role --
        // so this is a warning, not a refusal (spec S5).
        if root.orphaned != "": Text {
            text: root.orphaned;
            color: #ffcc00;
            font-size: 11px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            Button {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            Button {
                text: "Save";
                primary: true;
                enabled: root.can-save;
                clicked => { root.save(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Coach Cuts";
    // Every control fits at this size. The window opens at the size it last
    // closed at, which Rust sets from the app's state file, and at a roomier
    // one the first time.
    min-width: 1100px;
    min-height: 700px;
    background: Palette.background;
    forward-focus: keys;

    // --- Video (set by the renderer bridge in `src/video.rs`) ---

    /// The newest video frame (a borrowed GL texture).
    in property <image> frame;
    /// Display size of `frame`, from the negotiated caps (pixel aspect ratio
    /// included), so the picture is never stretched. Only its shape matters.
    in property <float> frame-width: 16;
    in property <float> frame-height: 9;
    /// The camera, live, while recording (set by `src/video.rs`), in square
    /// pixels. Drawn where the export puts the webcam inset, so what the
    /// coach sees is what viewers will.
    in property <image> self-view;
    /// Recording (or starting) with the camera's frames arriving. Cleared by
    /// `src/main.rs` when they stop, so a self-view that failed or stalled
    /// is hidden rather than frozen. An avatar take has no frames and stays
    /// up for the whole of it (avatar G2).
    in property <bool> self-view-shown;
    /// How loud the coach is right now, `0..=1`, smoothed: the avatar's size
    /// follows it (avatar G2). **1 outside an avatar take**, where it places
    /// the camera's inset exactly as it always was.
    in property <float> self-view-level: 1.0;
    /// This take's inset is the project's avatar, not the camera (avatar G2).
    /// It picks the placement rule: an avatar is drawn in its own, smaller
    /// box (`core::layout::avatar_self_view_rect`).
    in property <bool> self-view-avatar;
    /// Where the inset lands on the picture (`core::layout::
    /// pip_rect_over_picture`, sized by `core::avatar::avatar_rect`), from
    /// the content rect, the inset's aspect, the level and which kind of take
    /// it is. Pure, like `place-picture`.
    pure callback place-self-view(PictureRect, float, float, bool) -> PictureRect;

    // --- Zoom (spec D9; the state and the math are on the Rust side) ---

    in property <ZoomState> zoom: { scale: 1 };
    /// Core's `SNAP_NOTCHES`, for the indicator's ticks.
    in property <[float]> zoom-notches;
    out property <length> player-width: player.width;
    out property <length> player-height: player.height;
    /// The content rect: the letterboxed picture at 1×, which the drawing
    /// area is sized to and strokes are normalized against (Phase 6 D2).
    /// Zero before the first layout, or with nothing loaded.
    out property <length> content-width: player.content.width;
    out property <length> content-height: player.content.height;
    /// The picture's rect at `zoom`. Pure, so the binding that calls it is
    /// re-evaluated whenever an argument changes.
    pure callback place-picture(ZoomState, float, float, length, length) -> PictureRect;
    /// A scroll over the player at (x, y): pan, or zoom with Ctrl.
    callback zoom-scroll(length, length, length, length, bool, bool);
    /// The primary button went down over the player at (x, y) ...
    callback zoom-press(length, length);
    /// ... and, still down, the pointer moved to (x, y).
    callback zoom-drag(length, length);

    // --- Project state (from bus events) ---

    in property <bool> has-project;
    /// The project-name field's text.
    in-out property <string> project-name;
    /// The name the field returns to when it loses focus: the project's, or
    /// a rename just sent.
    in property <string> saved-project-name;
    changed saved-project-name => {
        // Never over a name being typed: leaving the field shows it.
        if (!name-edit.has-focus) {
            root.project-name = self.saved-project-name;
        }
    }
    in property <[SourceRow]> sources;
    /// The first missing source, or -1.
    in property <int> missing-index: -1;
    in property <string> missing-name;
    in property <bool> playing;
    /// The game video's speed, 1 to 32 (spec S), from the bus.
    in property <float> scan-speed: 1;
    /// Sources, none missing: play, seek and scrub are possible.
    in property <bool> can-play;

    // --- Transport ---

    /// Concat-timeline length, seconds.
    in property <float> total-seconds;
    /// The scrubber's value, concat seconds. Set by the 30 Hz timer except
    /// while `scrubbing`.
    in-out property <float> position-seconds;
    /// A scrub is under way, from its press to its end, however it ends
    /// (see `scrubber.slint`).
    out property <bool> scrubbing: scrubber.scrubbing;
    /// `current / total`.
    in property <string> readout: "0:00 / 0:00";
    /// Linear 0..1.
    in-out property <float> volume: 1;

    // --- Recording (Phase 4 R11) ---

    in property <RecordingPhase> recording-phase;
    /// Not idle. Greys out everything the bus refuses while recording (R6's
    /// guard): the source and clip lists, Open Project, rename, the scrubber
    /// and the Devices button.
    out property <bool> recording: root.recording-phase != RecordingPhase.idle;
    /// Time since the recording's t0, already formatted.
    in property <string> recording-elapsed: "0:00";
    /// The microphone's peak as a fraction of the level bar, 0..1.
    in property <float> level;
    /// A level has arrived during this recording.
    in property <bool> level-seen;
    /// The Clips list: the project's clips, or only those tagged
    /// `tag-filter`.
    in property <[ClipRow]> clips;
    /// All the project's clips, filtered or not.
    in property <int> clip-count;
    /// The export sheet would have a row: a clip, or a goal for the reel
    /// (spec R1). A project of goals and no clips can export its reel.
    in property <bool> can-export;
    /// The selected clip's id, empty for none (Phase 3 C7). UI state only:
    /// `src/main.rs` sets it on the bus's `Select`, and clears it on project
    /// open and when its clip leaves the project.
    in-out property <string> selected-clip;
    changed selected-clip => {
        // Its clip is gone: off a field the inspector is hiding.
        if (self.selected-clip == "") {
            keys.focus();
        }
        root.show-clip();
    }
    /// The inspector's fields (C7), set imperatively by `show-clip`: a
    /// `text:` or `checked:` binding breaks once the user types or clicks.
    in-out property <string> clip-name;
    in-out property <string> clip-tags;
    in-out property <string> clip-notes;
    in-out property <string> clip-transcript;
    in-out property <bool> clip-show-pip;
    /// The selected clip's inset is the avatar, not a camera (avatar G3):
    /// one word of the inspector's checkbox.
    in property <bool> clip-avatar;
    /// The selected clip's transcription and the line that describes it
    /// (Phase 10 S5). Both are written by `src/main.rs` from
    /// `Event::Transcription` -- and, unlike the fields above, they keep
    /// following it while a field is being edited.
    in property <TranscriptState> transcript-state;
    in property <string> transcript-status;
    /// The speech models on offer and which is chosen (Phase 10 S3): a
    /// machine-wide setting, written once at start-up from `state.json` and
    /// thereafter only by the picker, so it follows no event.
    in property <[string]> transcript-models;
    in-out property <int> transcript-model;
    in property <bool> transcript-model-enabled;
    /// The download the Transcribe button starts first, if the chosen model
    /// isn't on disk; empty otherwise (Phase 11 S3). Written by `src/main.rs`
    /// with the rest of the row.
    in property <string> transcribe-download;
    /// The clip an inspector field is editing, set when one gains focus and
    /// cleared when the last one loses it. Commits go to it, not to the
    /// selection, which a row click has already moved by the time a field's
    /// focus-loss handler runs. `show-clip` leaves the fields alone while
    /// it's set.
    in-out property <string> editing-clip-id;
    /// The tag overview's rows, alphabetical.
    in property <[TagRow]> tag-rows;
    /// Show only the clips with this tag; empty for all (C8). UI state only.
    in-out property <string> tag-filter;
    changed tag-filter => { root.filter-changed(); }
    /// The Devices popover's lists, "System default" first. Empty while
    /// they're being looked up.
    in property <[DeviceRow]> cameras;
    in property <[DeviceRow]> mics;
    /// The popover's Inset section: the project's avatar image, its file name
    /// (empty for none), and whether that file has gone missing (avatar G1).
    in property <image> avatar-thumb;
    in property <string> avatar-name;
    in property <bool> avatar-missing;

    // --- Drawing on the picture (Phase 6 D1, D5, D6) ---

    /// Only while recording, never `starting`: `recording` is the broader
    /// "not idle".
    out property <bool> can-draw: root.recording-phase == RecordingPhase.recording;
    /// A finished drawing clears itself 5 s after the pen lifts. UI state;
    /// `src/main.rs` reads it at pen-up.
    in-out property <bool> auto-clear: true;
    /// The live overlay: one stroke still on screen per row, its commands in
    /// content-rect logical pixels. `src/main.rs` rebuilds it only when
    /// something changes (D5) — Slint re-parses a `Path` on every set.
    in property <[LiveStroke]> live-paths;
    /// The pen's width, as a fraction of the picture's height
    /// (`core::layout::STROKE_LINE_WIDTH`): the live stroke layer and the
    /// highlight rings are drawn with it, so there is one pen width and Rust
    /// owns it. Set once, at startup.
    in property <float> stroke-line-width;
    /// The player highlights showing on the picture now (spec H5), likewise
    /// in content-rect pixels and likewise rebuilt only when they change.
    /// They belong to the **footage**, not to a clip, so they show while
    /// scanning as well as while recording.
    in property <[LiveHighlight]> live-highlights;

    // --- The H tool and the Highlights panel (spec H3) ---

    /// The tool is on. UI state: `H` toggles it and Esc leaves it.
    in-out property <bool> highlight-tool;
    /// ... and there is a picture to use it on. The touch area, the panel's
    /// hint and the swatch recolour all key off this, so a preview or an
    /// unloaded project can't leave a live tool behind. `highlight-tool`
    /// itself is left alone, so closing a preview gives the tool back.
    out property <bool> in-highlight-tool: root.highlight-tool && root.can-play && !root.previewing;
    /// Every highlight on the footage, in stored order.
    in property <[HighlightRow]> highlight-rows;
    /// The selected one's id, empty for none: a drag on its ring selects it,
    /// as does a click on its row.
    in-out property <string> selected-highlight;
    /// Its label, two-way down to the field; the window owns the value.
    in-out property <string> highlight-label;
    /// Which highlight the label field is editing, so a commit names it even
    /// after the selection has moved on -- `editing-clip-id`'s rule.
    in-out property <string> editing-highlight-id;
    /// The frame on screen carries one of the selected highlight's keys, so
    /// "Delete key here" has something to remove. From the 30 Hz tick.
    in property <bool> highlight-key-here;
    /// The stroke under the pen, likewise; empty when nothing is being drawn.
    in property <string> drawing-path;
    /// ... and its colour, the pen's when it went down.
    in property <color> drawing-ink;
    /// The pens' colours, in the swatch row's order (`drawing::Pen::ALL`),
    /// and which one new strokes are drawn with. `src/main.rs` owns the
    /// choice and remembers it across sessions.
    in property <[color]> pen-colors;
    in property <int> pen-index;

    // --- Export (Phase 8 E8): the sheet is the only export UI ---

    /// The sheet is up. UI state: the Export… button and the clip menu's
    /// "Export video…" open it, its own buttons and Esc close it.
    in-out property <bool> export-sheet-open;
    /// Its target list, in the order it shows them: All clips, each tag, then
    /// the clip the sheet was opened on. `src/main.rs` holds the targets these
    /// rows stand for, and owns the ticks.
    in property <[TargetRow]> export-targets;
    in property <bool> export-any-ticked;
    /// The pickers, seeded from the project's preferences when the sheet opens
    /// and persisted by the bus when a run starts (spec E4).
    in-out property <int> export-resolution;
    in-out property <int> export-quality;
    in-out property <int> export-scoreboard;
    /// Whether the whole-match row is ticked, which is what decides whether
    /// the Scoreboard picker's explanatory line applies.
    in property <bool> export-whole-match-ticked;
    /// The run in progress, and when it finishes; both from the bus's events,
    /// so a closed sheet reopens on the run it left.
    in property <[RunRow]> export-run;
    in property <string> export-finish;
    /// A run is going. Greys out Record, a preview and "Export video…", all of
    /// which the bus refuses while one is.
    in property <bool> exporting;

    // --- Preview (Phase 7 P6) ---

    /// The clip on screen instead of the game video, empty with none, and its
    /// name for the indicator. Set from the bus's `Preview` event.
    in property <string> previewing-clip;
    in property <string> previewing-name;
    out property <bool> previewing: root.previewing-clip != "";
    /// Opening one is refused while recording or exporting (P5), and needs
    /// something to play.
    out property <bool> can-preview: root.can-play && !root.recording && !root.exporting;

    // --- Match (Phase 9 S4): the panel, the three tag keys, the setup sheet ---

    /// The project has teams: the scoreboard is drawn, and the panel shows a
    /// score and clock rather than the way in to the sheet.
    in property <bool> match-configured;
    /// The live line and clock, rendered by `src/main.rs` from the scan
    /// anchor on the tick. Frozen while a preview is open (S4).
    in property <string> match-score;
    in property <string> match-clock;
    /// Every tagged event in match order.
    in property <[MatchRow]> match-rows;
    /// The Match list's height in lines: a row each, and a second for a
    /// goal's reel span.
    in property <int> match-list-lines;
    /// A tick on the scrubber per match event (spec C1), on the concat
    /// timeline's scale.
    in property <[Mark]> match-marks;
    /// Every period of the format is tagged, so the bus would refuse another
    /// start/stop: the action is off and the panel says why (S5).
    in property <bool> match-at-cap;
    /// The one gate on tagging, shared by the three keys and the panel's
    /// buttons: while scanning or recording, never while previewing or during
    /// a recording's start-up.
    out property <bool> can-tag:
        root.can-play && !root.previewing && root.recording-phase != RecordingPhase.starting;
    /// The setup sheet is up. UI state: the panel's button opens it, its own
    /// buttons and Esc close it.
    in-out property <bool> match-sheet-open;
    /// Its fields, seeded from the project when it opens and read back on
    /// Save (`src/main.rs`). Two-way bound down to the fields, since a
    /// `text:` or `checked:` binding breaks once the user edits it.
    in-out property <string> match-home-name;
    in-out property <string> match-home-primary;
    in-out property <string> match-home-secondary;
    in-out property <string> match-home-font;
    in-out property <string> match-away-name;
    in-out property <string> match-away-primary;
    in-out property <string> match-away-secondary;
    in-out property <string> match-away-font;
    in-out property <string> match-regulation-periods;
    in-out property <string> match-regulation-minutes;
    in-out property <string> match-overtime-periods;
    in-out property <string> match-overtime-minutes;
    in-out property <bool> match-back-anchor;

    /// The latest notice (a device fallback, an unclean stop, an export
    /// done), shown in the transport bar without blocking; empty hides it.
    in property <string> notice;

    /// The error dialog's message; empty hides it.
    in-out property <string> error-message;
    /// A text field has focus: every shortcut yields to it (C6).
    /// J, L and the speed button (spec S1, S2): only while scanning.
    property <bool> can-scan-fast: root.playing && !root.recording && !root.previewing && root.can-play;
    property <bool> text-editing: name-edit.has-focus || inspector.editing || highlights.editing;

    callback open-project();
    callback add-source();
    callback relink-source(int);
    callback remove-source(int);
    callback move-source(int, int);
    callback rename-project(string);
    callback toggle-play();
    /// Skip by this many seconds (negative is backwards).
    callback skip(float);
    /// `,` and `.`: one frame back or forward, while paused.
    callback step-frame(bool);
    /// `J`, `L` and the speed button: a speed slower or faster, while
    /// scanning.
    callback step-scan-speed(ScanStep);
    callback scrub-move(float);
    callback scrub-release(float);
    /// R, Record or Stop: the bus starts a recording when idle, else stops
    /// (or aborts) it.
    callback toggle-recording();
    /// Esc: stop (or abort) the recording.
    callback stop-recording();
    /// The Devices popover opened: look the devices up.
    callback list-devices();
    /// A row of the popover's camera or microphone list was picked: its
    /// `node-name`, empty for the system default.
    callback choose-camera(string);
    callback choose-mic(string);
    /// The popover's Choose… and Remove for the avatar image: pick a PNG or a
    /// JPEG to copy into the project, or drop the one it has.
    callback choose-avatar();
    callback remove-avatar();
    /// Clips (Phase 3 C5), by id; `move-clip` takes list indices.
    callback jump-to-clip(string);
    callback delete-clip(string);
    callback move-clip(int, int);
    callback sort-clips();
    /// Open the export sheet on the selection, with everything else ticked
    /// (the Export… button) ...
    callback open-export();
    /// ... or on this clip alone, ticked (the clip menu's "Export video…").
    callback export-clip(string);
    /// The target row at this index was ticked or unticked.
    callback tick-target(int, bool);
    /// Export what's ticked, at the pickers' resolution and quality.
    callback start-export();
    callback cancel-export();
    /// Preview the clip with this id, in place of the game video, and close
    /// the one open (P5).
    callback open-preview(string);
    callback close-preview();
    /// Match events (Phase 9 S4), by the event's id where they name one. The
    /// tag's position is the readout's, taken in `src/main.rs` at the input
    /// event, as the bus contract requires.
    callback tag-match-event(MatchTag);
    callback seek-match-event(string);
    callback delete-match-event(string);
    /// A goal row's reel buttons (R3). The scan position is taken in
    /// `src/main.rs` at the click, as a tag's is.
    callback reel-trim(string, ReelTrim);
    /// `]` (true) or `[`: the next or previous chapter (spec C1).
    callback jump-chapter(bool);
    /// Seed the setup sheet's fields from the project and open it; the sheet
    /// is opened nowhere else, so the fields are never stale.
    callback open-match-setup();
    /// Save the setup sheet's fields as the project's scoreboard.
    callback save-match-setup();
    /// A colour field's text as a colour, and the sheet's validators, which
    /// take their text so the bindings re-evaluate as it's typed.
    pure callback hex-color(string) -> color;
    pure callback valid-name(string) -> bool;
    pure callback valid-hex(string) -> bool;
    pure callback valid-periods(string) -> bool;
    pure callback valid-overtime-periods(string) -> bool;
    pure callback valid-minutes(string) -> bool;
    /// The sheet's warning for start/stops the format being typed has no
    /// period for, empty when there are none. The back-anchor is an argument
    /// because its derived start takes one of those periods.
    pure callback match-over-cap(string, string, bool) -> string;
    callback undo();
    callback redo();
    /// An inspector field's commit for clip `id`.
    callback edit-clip(string, ClipField, string);
    callback set-show-pip(string, bool);
    /// Queue clip `id`'s commentary for transcription (Phase 10 S6).
    callback transcribe(string);
    /// Stop the transcription running and drop the queue behind it.
    callback cancel-transcription();
    /// Run this speech model from now on, by index into `transcript-models`.
    callback set-transcribe-model(int);
    /// Render the inspector's fields from the selected clip, unless one is
    /// being edited.
    callback show-clip();
    /// `tag-filter` changed: list the clips it lets through.
    callback filter-changed();
    pure callback suggest-tags(string) -> [string];
    pure callback take-suggestion(string, string) -> string;
    callback volume-changed(float);
    callback volume-released(float);
    /// Zoom keys (spec D9): `1`/`Ctrl+0` reset; `2`/`3` step the scale about
    /// the pointer at (x, y) when it's over the player (the bool).
    callback zoom-reset();
    callback zoom-step(float, bool, length, length);
    /// Drawing (Phase 6 D2): the pen went down at (x, y) over the picture,
    /// moved with it down, and came up. Content-rect relative, and the last
    /// two may be outside it: Slint grabs the pointer on press.
    callback draw-press(length, length);
    callback draw-move(length, length);
    callback draw-release(length, length);
    /// The grab was taken away mid-stroke (see the drawing area): whatever is
    /// under the pen is dropped, unlogged.
    callback draw-cancel();
    /// The H tool (spec H3): a press over the picture, and the release that
    /// makes the box a key. Content-rect relative, like the pen's, and the
    /// release may be outside it: Slint grabs the pointer on press.
    callback highlight-press(length, length);
    callback highlight-release(length, length);
    /// The grab was taken away mid-drag: the box is dropped.
    callback highlight-cancel();
    /// The Highlights panel's rows.
    callback select-highlight(string);
    callback delete-highlight(string);
    /// "Delete key here": the selected highlight's key on the frame on screen.
    callback delete-highlight-key(string);
    /// The label field committed with Enter, or lost focus, which commits
    /// too. Gaining focus is the window's own business: it only notes which
    /// highlight the field is on.
    callback commit-highlight-label(string);
    callback end-highlight-label(string);
    /// Clear: the button, or C.
    callback clear-drawings();
    /// A swatch was clicked: draw with the pen at this index from now on.
    callback pick-pen(int);
    /// Drag-to-reorder payload: a row index of the named list ("sources" or
    /// "clips") to and from `data-transfer`; -1 when it's another list's.
    pure callback drag-payload(string, int) -> data-transfer;
    pure callback dropped-index(string, data-transfer) -> int;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    /// Closes the setup sheet, however it was closed, and puts focus back on
    /// the window so the shortcuts work again.
    function close-match-setup() {
        root.match-sheet-open = false;
        keys.focus();
    }

    /// One of the three match tag keys (S4), under the gate the panel's
    /// buttons share -- the cap included, which only the start/stop has: the
    /// bus refuses a tag there, and that refusal is a backstop, not something
    /// to walk into from the keyboard mid-recording. A held key must not
    /// insert a goal per repeat, and the key is swallowed either way, as `c`
    /// and `r` are.
    function tag-key(kind: MatchTag, event: KeyEvent, pressed: bool) -> EventResult {
        if (pressed && !event.repeat && root.can-tag
            && !(kind == MatchTag.start-stop && root.match-at-cap)) {
            root.tag-match-event(kind);
        }
        return accept;
    }

    /// Spec D10: every shortcut, ahead of whichever child has focus, so a
    /// touched slider never turns arrows into volume or scrub steps. Called
    /// for releases too (`pressed` false), which are swallowed for the same
    /// keys: a slider fires `released` on an arrow key's release.
    function handle-key(event: KeyEvent, pressed: bool) -> EventResult {
        if (root.error-message != "") {
            // Modal: nothing reaches the window behind the dialog.
            if (pressed && (event.text == Key.Return || event.text == Key.Escape)) {
                root.error-message = "";
            }
            return accept;
        }
        // The export sheet is modal over the window's shortcuts: Esc closes
        // it, and a run it started goes on behind it.
        if (root.export-sheet-open) {
            if (pressed && event.text == Key.Escape) {
                root.export-sheet-open = false;
            }
            return accept;
        }
        // The match setup sheet is modal too, and it has fields of its own:
        // Esc closes it, and everything else goes to whatever in it has
        // focus. Ahead of the Esc cascade and the tag keys, so neither fires
        // behind it.
        if (root.match-sheet-open) {
            if (pressed && event.text == Key.Escape) {
                root.close-match-setup();
                return accept;
            }
            return reject;
        }
        // The field gets them all, Esc included: it bubbles back to
        // `key-pressed` below.
        if (root.text-editing) {
            return reject;
        }
        // No shortcut, but a touched slider would take them.
        if (event.text == Key.Home || event.text == Key.End) {
            return accept;
        }
        if (event.modifiers.control) {
            if (event.text == "o" || event.text == "O") {
                if (pressed && !root.recording) {
                    root.open-project();
                }
                return accept;
            }
            // Not while previewing: the picture is at identity zoom then
            // (P6), so a change would only show once it closes.
            if (event.text == "0") {
                if (pressed && !root.previewing) {
                    root.zoom-reset();
                }
                return accept;
            }
            // Ctrl+Z undoes; Ctrl+Shift+Z (Z shifted) or Ctrl+Y redoes. Not
            // while recording, which the bus refuses.
            if (event.text == "z" || event.text == "Z" || event.text == "y" || event.text == "Y") {
                if (pressed && !root.recording) {
                    if (event.text == "y" || event.text == "Y" || event.modifiers.shift) {
                        root.redo();
                    } else {
                        root.undo();
                    }
                }
                return accept;
            }
            return reject;
        }
        // Clear the drawings (D6). After the Ctrl branch, so Ctrl+C isn't it.
        // A held C would clear over and over, which does nothing but log.
        if (event.text == "c" || event.text == "C") {
            if (pressed && !event.repeat && root.can-draw) {
                root.clear-drawings();
            }
            return accept;
        }
        // The three match tags (S4): direct keys, since this port has them
        // free -- no event mode, so no second gate on the zoom keys and no
        // extra layer in the Esc cascade. After the Ctrl branch, so Ctrl+Z
        // isn't one of them.
        if (event.text == "z" || event.text == "Z") {
            return root.tag-key(MatchTag.home-goal, event, pressed);
        }
        if (event.text == "x" || event.text == "X") {
            return root.tag-key(MatchTag.away-goal, event, pressed);
        }
        if (event.text == "v" || event.text == "V") {
            return root.tag-key(MatchTag.start-stop, event, pressed);
        }
        // The H tool (spec H3), under the tag keys' gate: like them it works
        // while a recording is paused, because a highlight belongs to the
        // footage rather than to the take. It toggles, so a held key would
        // toggle straight back.
        if (event.text == "h" || event.text == "H") {
            if (pressed && !event.repeat && root.can-tag) {
                root.highlight-tool = !root.highlight-tool;
            }
            return accept;
        }
        // R and Space toggle, so an auto-repeat would toggle straight back.
        if (event.text == "r" || event.text == "R") {
            if (pressed && !event.repeat) {
                root.toggle-recording();
            }
            return accept;
        }
        // Esc cascade (C6, P6, H3): the dialog above, then the H tool, then
        // the recording, then the preview, then the selection.
        //
        // **The tool goes before the recording** (H3): in it the first Esc
        // deselects and the next leaves the tool, so a coach ringing a
        // player during a paused take never stops the take with it.
        if (event.text == Key.Escape) {
            if (pressed) {
                if (root.in-highlight-tool) {
                    if (root.selected-highlight != "") {
                        root.selected-highlight = "";
                    } else {
                        root.highlight-tool = false;
                    }
                } else if (root.recording) {
                    root.stop-recording();
                } else if (root.previewing) {
                    root.close-preview();
                } else {
                    root.selected-clip = "";
                }
            }
            return accept;
        }
        if (event.text == Key.Delete) {
            if (pressed && !root.recording && root.selected-clip != "") {
                root.delete-clip(root.selected-clip);
            }
            return accept;
        }
        if (event.text == " ") {
            if (pressed && !event.repeat) {
                root.toggle-play();
            }
            return accept;
        }
        if (event.text == Key.LeftArrow || event.text == "a" || event.text == "A") {
            if (pressed) {
                root.skip(event.modifiers.shift ? -10 : -3);
            }
            return accept;
        }
        if (event.text == Key.RightArrow || event.text == "d" || event.text == "D") {
            if (pressed) {
                root.skip(event.modifiers.shift ? 10 : 3);
            }
            return accept;
        }
        // One frame while paused; the bus refuses it while playing. Held, it
        // repeats, as the skips do.
        if (event.text == "," || event.text == ".") {
            if (pressed && !root.recording && !root.previewing && root.can-play) {
                root.step-frame(event.text == ".");
            }
            return accept;
        }
        // The next or previous match event (C1), with a Match row's seek
        // gate: the seek is a scrub release, which the bus refuses while
        // recording, and it belongs to the game video behind a preview.
        if (event.text == "[" || event.text == "]") {
            if (pressed && !root.recording && !root.previewing && root.can-play) {
                root.jump-chapter(event.text == "]");
            }
            return accept;
        }
        // Faster or slower while scanning (spec S1): L doubles up to 32x, J
        // halves down to 1x. Not while recording or previewing, which are 1x.
        if (event.text == "j" || event.text == "J" || event.text == "l" || event.text == "L") {
            if (pressed && !event.repeat && root.can-scan-fast) {
                root.step-scan-speed(event.text == "l" || event.text == "L" ? ScanStep.faster : ScanStep.slower);
            }
            return accept;
        }
        if (event.text == "1") {
            if (pressed && !root.previewing) {
                root.zoom-reset();
            }
            return accept;
        }
        if (event.text == "2" || event.text == "3") {
            if (pressed && !root.previewing) {
                root.zoom-step(event.text == "2" ? -0.25 : 0.25, zoom-area.has-hover, zoom-area.mouse-x, zoom-area.mouse-y);
            }
            return accept;
        }
        reject
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            root.handle-key(event, true)
        }
        capture-key-released(event) => {
            root.handle-key(event, false)
        }
        // Esc a field didn't take leaves it, which commits it (C6). The only
        // way out of the notes field by keyboard.
        key-pressed(event) => {
            if (root.text-editing && event.text == Key.Escape) {
                keys.focus();
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                // --- Sidebar ---
                Rectangle {
                    width: 240px;
                    background: Palette.alternate-background;

                    // Empty space: off any field (C6), which Slint doesn't do
                    // on a click.
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "Project";
                            color: Palette.alternate-foreground;
                            font-size: 11px;
                        }

                        name-edit := LineEdit {
                            enabled: root.has-project && !root.recording;
                            placeholder-text: root.has-project ? "" : "No project";
                            text <=> root.project-name;
                            accepted(name) => {
                                root.rename-project(name);
                                keys.focus();
                            }
                            // Accepting or leaving the field shows the saved
                            // name, so an empty, unchanged or abandoned edit
                            // doesn't linger.
                            changed has-focus => {
                                if (!self.has-focus) {
                                    root.project-name = root.saved-project-name;
                                }
                            }
                        }

                        Text {
                            text: "Sources";
                            color: Palette.alternate-foreground;
                            font-size: 11px;
                        }

                        ListView {
                            for source[index] in root.sources: Rectangle {
                                height: 48px;
                                background: drop.has-drag ? Palette.selection-background : transparent;
                                border-radius: 4px;

                                drop := DropArea {
                                    enabled: !root.recording;
                                    can-drop(event) => {
                                        root.dropped-index("sources", event.data) >= 0 ? DragAction.move : DragAction.none
                                    }
                                    dropped(event) => {
                                        root.move-source(root.dropped-index("sources", event.data), index);
                                        DragAction.move
                                    }

                                    DragArea {
                                        enabled: !root.recording;
                                        allow-move: true;
                                        data: root.drag-payload("sources", index);

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 2px;
                                            spacing: 6px;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;

                                                Text {
                                                    text: source.name;
                                                    color: Palette.foreground;
                                                    overflow: elide;
                                                }

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: source.duration;
                                                        color: Palette.alternate-foreground;
                                                        font-size: 11px;
                                                    }
                                                    if source.missing: Text {
                                                        text: "Missing";
                                                        color: #ff6b6b;
                                                        font-size: 11px;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "×";
                                                    accessible-label: "Remove";
                                                    enabled: !source.referenced && !root.recording;
                                                    clicked => {
                                                        root.remove-source(index);
                                                    }

                                                    Tooltip {
                                                        text: source.referenced
                                                            ? @markdown("Used by a clip, a match event or a highlight. Delete those first.")
                                                            : @markdown("Remove from the project");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "Clips";
                                color: Palette.alternate-foreground;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Sort by position";
                                enabled: root.clip-count >= 2 && !root.recording;
                                clicked => { root.sort-clips(); }

                                Tooltip {
                                    text: @markdown("Order the clips by where they start in the match");
                                }
                            }
                        }

                        // The overview's filter (C8), cleared by a click.
                        if root.tag-filter != "": Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: chip-touch.has-hover ? Palette.selection-background : Palette.control-background;

                            chip-touch := TouchArea {
                                clicked => { root.tag-filter = ""; }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;

                                Text {
                                    text: "Filtered: " + root.tag-filter;
                                    color: Palette.foreground;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "✕";
                                    color: Palette.alternate-foreground;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.tag-filter != "" && root.clips.length == 0: Text {
                            text: "No clips tagged '" + root.tag-filter + "'";
                            color: Palette.alternate-foreground;
                            wrap: word-wrap;
                        }

                        // Phase 3 C9. A click selects (never toggles: a
                        // double-click is two clicks first), a double-click
                        // jumps, a right-click opens the row's own menu without
                        // selecting, and a drag reorders. All off while
                        // recording, which the bus refuses. No drag while
                        // filtered: a filtered row's index isn't its place in
                        // the full order.
                        ListView {
                            for clip[index] in root.clips: Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                background: clip-drop.has-drag || clip.id == root.selected-clip
                                    ? Palette.selection-background
                                    : transparent;

                                clip-drop := DropArea {
                                    enabled: !root.recording && root.tag-filter == "";
                                    can-drop(event) => {
                                        root.dropped-index("clips", event.data) >= 0 ? DragAction.move : DragAction.none
                                    }
                                    dropped(event) => {
                                        root.move-clip(root.dropped-index("clips", event.data), index);
                                        DragAction.move
                                    }

                                    DragArea {
                                        enabled: !root.recording && root.tag-filter == "";
                                        allow-move: true;
                                        data: root.drag-payload("clips", index);

                                        TouchArea {
                                            enabled: !root.recording;
                                            clicked => {
                                                root.selected-clip = clip.id;
                                                // Off any field, so the keys work.
                                                keys.focus();
                                            }
                                            double-clicked => {
                                                root.jump-to-clip(clip.id);
                                            }
                                        }

                                        ContextMenuArea {
                                            enabled: !root.recording;
                                            Menu {
                                                MenuItem {
                                                    title: "Jump to clip start";
                                                    activated => { root.jump-to-clip(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Preview clip";
                                                    enabled: root.can-preview;
                                                    activated => { root.open-preview(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Export video…";
                                                    enabled: !root.exporting && !root.previewing;
                                                    activated => { root.export-clip(clip.id); }
                                                }
                                                MenuItem {
                                                    title: "Delete clip";
                                                    activated => { root.delete-clip(clip.id); }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 8px;

                                            Text {
                                                text: clip.name;
                                                color: root.recording ? Palette.alternate-foreground : Palette.foreground;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: clip.duration;
                                                color: Palette.alternate-foreground;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Player area: black, the picture fitted, zoomed and
                // panned (spec D9) ---
                player := Rectangle {
                    /// The zoom the picture is drawn at: identity while
                    /// previewing (P6), since the preview's texture already
                    /// has the coach's zoom baked in and the scan-time
                    /// transform would apply it twice. The window's `zoom` is
                    /// left alone, so closing the preview restores the view.
                    property <ZoomState> shown-zoom: root.previewing ? { scale: 1, pan-x: 0, pan-y: 0 } : root.zoom;
                    property <PictureRect> picture: root.place-picture(self.shown-zoom, root.frame-width, root.frame-height, self.width, self.height);
                    // The letterboxed rect at 1×. The zoomed picture is clipped
                    // to it, not to the whole player area, so the view is
                    // exactly the crop export produces (spec D9: one
                    // `Zoom::transform`) and the letterbox bars stay black at
                    // any zoom. Phase 6 strokes are normalized to this rect too.
                    property <PictureRect> content: root.place-picture({ scale: 1, pan-x: 0, pan-y: 0 }, root.frame-width, root.frame-height, self.width, self.height);

                    background: black;
                    clip: true;

                    // Off any field (C6), with nothing to zoom; `zoom-area`
                    // does it otherwise.
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    Rectangle {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        clip: true;

                        // Drawn at 1× size and scaled up by a transform, rather
                        // than sized to `picture`: Skia rounds a translate-only
                        // image's origin to whole pixels, so a slow pan would
                        // step 1 px at a time. With a scale in the transform it
                        // moves smoothly. (At 1× nothing pans, so the rounding
                        // left there is harmless.) Same rect either way.
                        // Coordinates are relative to the content rect.
                        Image {
                            source: root.frame;
                            x: player.picture.x - player.content.x;
                            y: player.picture.y - player.content.y;
                            width: player.picture.width / player.shown-zoom.scale;
                            height: player.picture.height / player.shown-zoom.scale;
                            transform-origin: { x: 0, y: 0 };
                            transform-scale: player.shown-zoom.scale;
                            image-fit: fill;
                        }
                    }

                    // The live self-view -- the camera, or the project's
                    // avatar breathing with the voice -- where the export's
                    // inset goes: over the picture, under the drawings (the
                    // export's layer order), placed on the content rect so
                    // the zoom doesn't move it. Outside the content clip,
                    // since on a picture that isn't 16:9 the inset reaches
                    // into the bars, as it does in the export. It takes no
                    // input: a drag that starts on it draws, as the stroke
                    // lands over the inset in the export too.
                    if root.self-view-shown: Image {
                        property <PictureRect> at: root.place-self-view(player.content, root.self-view.width / root.self-view.height, root.self-view-level, root.self-view-avatar);
                        x: self.at.x;
                        y: self.at.y;
                        width: self.at.width;
                        height: self.at.height;
                        source: root.self-view;
                        image-fit: fill;
                    }

                    Rectangle {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        clip: true;

                        // The live telestration layer (D5) and the player
                        // highlights (H5), above the picture and clipped with
                        // it. Strokes are drawn where they were made, on the
                        // zoomed picture as seen, so they don't move with the
                        // zoom; a ring is placed in the footage, so it does.
                        //
                        // Hidden while previewing (P6): the preview's texture
                        // already has the clip's drawings and its rings
                        // rasterized into it, and whatever is still on screen
                        // from scanning belongs to the game video, not to the
                        // clip.
                        if !root.previewing: Rectangle {
                            // The player highlights (H5), **under** the
                            // drawings, which is the layer order export
                            // burns in. Every pill goes over every ring, so
                            // one player's number is never cut in half by the
                            // next player's ring.
                            for ring in root.live-highlights: StrokePath {
                                commands: ring.commands;
                                ink: ring.ink;
                                line-width: root.stroke-line-width;
                            }
                            for ring in root.live-highlights: HighlightLabel {
                                label: ring.label;
                                ink: ring.ink;
                                label-ink: ring.label-ink;
                                anchor-x: ring.label-x;
                                anchor-y: ring.label-y;
                                font-size: ring.font-size;
                                label-pad: ring.label-pad;
                                pill-height: ring.pill-height;
                                content-width: parent.width;
                            }
                            for stroke in root.live-paths: StrokePath {
                                commands: stroke.commands;
                                ink: stroke.ink;
                                line-width: root.stroke-line-width;
                            }
                            // The one under the pen. An empty `commands` draws
                            // nothing, so it needs no `if`.
                            StrokePath {
                                commands: root.drawing-path;
                                ink: root.drawing-ink;
                                line-width: root.stroke-line-width;
                            }
                        }
                    }

                    zoom-area := TouchArea {
                        // Only over a picture: the empty-state cards cover it
                        // otherwise. Off while previewing, which is at
                        // identity zoom (P6).
                        enabled: root.can-play && !root.previewing;
                        scroll-event(event) => {
                            root.zoom-scroll(self.mouse-x, self.mouse-y, event.delta-x, event.delta-y, event.modifiers.control, event.modifiers.shift);
                            accept
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                keys.focus();
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.zoom-press(self.mouse-x, self.mouse-y);
                            }
                        }
                        // Only while a button is down; `pressed` is the primary one.
                        moved => {
                            if (self.pressed) {
                                root.zoom-drag(self.mouse-x, self.mouse-y);
                            }
                        }
                    }

                    ZoomIndicator {
                        x: (parent.width - self.width) / 2;
                        y: 12px;
                        // Identity while previewing, where it hides itself.
                        scale: player.shown-zoom.scale;
                        notches: root.zoom-notches;
                    }

                    if !root.has-project: EmptyCard {
                        title: "No project open";
                        message: "Open a folder to start scanning match footage. Coach Cuts keeps its project file (project.json) inside the folder.";
                        action: "Open Project…";
                        clicked => { root.open-project(); }
                    }
                    if root.has-project && root.sources.length == 0: EmptyCard {
                        title: "No source video added";
                        message: "Add the match video you want to scan. Several videos (for example two halves) play as one timeline.";
                        action: "Add Source Video…";
                        clicked => { root.add-source(); }
                    }
                    if root.has-project && root.sources.length > 0 && root.missing-index >= 0: EmptyCard {
                        title: "Source video is missing: " + root.missing-name;
                        message: "Coach Cuts can't find this video. It may have been moved, renamed or deleted. Pick its current location to continue.";
                        action: "Relink…";
                        // The bus refuses it while recording (R6's guard).
                        enabled: !root.recording;
                        clicked => { root.relink-source(root.missing-index); }
                    }

                    // --- Drawing (Phase 6 D1) ---
                    // The player's last child but the H tool's: Slint visits
                    // children front to back and a TouchArea grabs the
                    // pointer on press, so declared any earlier the presses
                    // would go to `zoom-area` and pan instead. Sized to the
                    // content rect, so a press in the letterbox bars still
                    // pans, and `mouse-x/y` are already content-relative.
                    //
                    // It accepts no scroll event, so wheels fall through to
                    // `zoom-area` behind it and pan and Ctrl-zoom keep
                    // working. Disabled it forwards everything and shows no
                    // cursor of its own.
                    TouchArea {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        enabled: root.can-draw;
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            // Slint drops the grab and sends a cancel when a
                            // grabbing area sees an exit or is disabled
                            // mid-stroke — the recording stopping, say. It
                            // carries `button: other`, so it has to come
                            // before the test below, or the stroke would be
                            // left on screen and never logged.
                            if (event.kind == PointerEventKind.cancel) {
                                root.draw-cancel();
                                return;
                            }
                            if (event.button != PointerEventButton.left) {
                                return;
                            }
                            if (event.kind == PointerEventKind.down) {
                                keys.focus();
                                root.draw-press(self.mouse-x, self.mouse-y);
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.draw-release(self.mouse-x, self.mouse-y);
                            }
                        }
                        // Only while a button is down; `pressed` is the
                        // primary one. The pointer is grabbed on press, so
                        // this keeps arriving off the picture; the stroke
                        // clamps to the edge.
                        moved => {
                            if (self.pressed) {
                                root.draw-move(self.mouse-x, self.mouse-y);
                            }
                        }
                    }

                    // --- The H tool (spec H3) ---
                    // After the drawing area, so in the tool a press rings a
                    // player rather than drawing one over. On the content
                    // rect like it, so `mouse-x/y` are already the pixels
                    // `drag_rect` maps through the zoom, and a drag in the
                    // letterbox bars still pans.
                    highlight-area := TouchArea {
                        x: player.content.x;
                        y: player.content.y;
                        width: player.content.width;
                        height: player.content.height;
                        enabled: root.in-highlight-tool;
                        mouse-cursor: crosshair;
                        pointer-event(event) => {
                            // As the drawing area's: a cancel carries
                            // `button: other`, so it comes first.
                            if (event.kind == PointerEventKind.cancel) {
                                root.highlight-cancel();
                                return;
                            }
                            if (event.button != PointerEventButton.left) {
                                return;
                            }
                            if (event.kind == PointerEventKind.down) {
                                keys.focus();
                                root.highlight-press(self.mouse-x, self.mouse-y);
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.highlight-release(self.mouse-x, self.mouse-y);
                            }
                        }
                    }

                    // The box under the pointer, in the pen's colour: what
                    // the key will hold. Only while the picture is paused,
                    // which is the only time a drag places anything (H3);
                    // clamped to the content rect, since the pointer is
                    // grabbed and `drag_rect` clamps the same way.
                    if highlight-area.pressed && !root.playing: Rectangle {
                        property <length> left: max(0px, min(highlight-area.pressed-x, highlight-area.mouse-x));
                        property <length> top: max(0px, min(highlight-area.pressed-y, highlight-area.mouse-y));
                        x: player.content.x + self.left;
                        y: player.content.y + self.top;
                        width: max(0px, min(player.content.width, max(highlight-area.pressed-x, highlight-area.mouse-x)) - self.left);
                        height: max(0px, min(player.content.height, max(highlight-area.pressed-y, highlight-area.mouse-y)) - self.top);
                        border-width: 1px;
                        border-color: root.pen-colors[root.pen-index];
                        background: #ffffff1a;
                    }
                }

                // --- Inspector: the selected clip, else the tag overview
                // (C7, C8) -- with the Match panel under it (Phase 9 S4) ---
                Rectangle {
                    width: 280px;
                    background: Palette.alternate-background;

                    // Empty space: off any field (C6).
                    TouchArea {
                        clicked => { keys.focus(); }
                    }

                    // Scrolls rather than push the transport bar off the
                    // window: a selected clip's fields over the Match panel
                    // are taller than a 700px window has room for. With room
                    // to spare, the layout fills the column and Notes takes
                    // the slack, as before. Clicks fall through it to the
                    // TouchArea behind: it pans only on the wheel.
                    ScrollView {
                        VerticalLayout {
                            // The clip inspector, or the tag overview with
                            // nothing selected; the Match panel is always under
                            // it, since a match is the project's, not a clip's.
                            Rectangle {
                                vertical-stretch: 1;
                                // Only a shown inspector holds the column
                                // open: hidden, its fields would still claim
                                // their height over the tag overview and
                                // scroll the Match panel for nothing.
                                min-height: inspector.visible ? inspector.min-height : 0;

                                // Hidden rather than removed, so `editing` always binds.
                                inspector := Inspector {
                                    visible: root.selected-clip != "";
                                    enabled: !root.recording;
                                    name-text <=> root.clip-name;
                                    tags-text <=> root.clip-tags;
                                    notes-text <=> root.clip-notes;
                                    transcript-text <=> root.clip-transcript;
                                    transcript-state: root.transcript-state;
                                    transcript-status: root.transcript-status;
                                    transcript-models: root.transcript-models;
                                    transcript-model <=> root.transcript-model;
                                    transcript-model-enabled: root.transcript-model-enabled;
                                    transcribe-download: root.transcribe-download;
                                    show-pip <=> root.clip-show-pip;
                                    avatar: root.clip-avatar;
                                    avatar-missing: root.avatar-missing;
                                    begin-edit => { root.editing-clip-id = root.selected-clip; }
                                    commit(field, text) => { root.edit-clip(root.editing-clip-id, field, text); }
                                    end-edit(field, text) => {
                                        let id = root.editing-clip-id;
                                        // Unless focus moved to another field, which
                                        // goes on editing the same clip.
                                        if (!self.editing) {
                                            root.editing-clip-id = "";
                                        }
                                        root.edit-clip(id, field, text);
                                    }
                                    can-preview: root.can-preview;
                                    previewing: root.previewing && root.previewing-clip == root.selected-clip;
                                    // The selection, since a click doesn't take focus
                                    // from a field.
                                    pip-toggled(on) => { root.set-show-pip(root.selected-clip, on); }
                                    // Off the fields first, as the Preview button
                                    // does: a click doesn't move focus, and the
                                    // machine's write is refused a re-render while
                                    // a field holds one.
                                    transcribe-clicked => {
                                        keys.focus();
                                        root.transcribe(root.selected-clip);
                                    }
                                    cancel-transcribe-clicked => {
                                        keys.focus();
                                        root.cancel-transcription();
                                    }
                                    // Off the fields as its siblings are: the
                                    // popup takes focus from a field being
                                    // edited, and the window's shortcuts must
                                    // come back afterwards.
                                    transcript-model-chosen(index) => {
                                        keys.focus();
                                        root.set-transcribe-model(index);
                                    }
                                    preview-clicked => {
                                        keys.focus();
                                        if (self.previewing) {
                                            root.close-preview();
                                        } else {
                                            root.open-preview(root.selected-clip);
                                        }
                                    }
                                    suggest-tags(text) => { return root.suggest-tags(text); }
                                    take-suggestion(text, tag) => { return root.take-suggestion(text, tag); }
                                }
                                if root.selected-clip == "": TagOverview {
                                    rows: root.tag-rows;
                                    clip-count: root.clip-count;
                                    filter <=> root.tag-filter;
                                }
                            }

                            MatchPanel {
                                configured: root.match-configured;
                                score: root.match-score;
                                clock: root.match-clock;
                                rows: root.match-rows;
                                lines: root.match-list-lines;
                                can-tag: root.can-tag;
                                at-cap: root.match-at-cap;
                                // The bus refuses a scrub and an edit while
                                // recording, and neither belongs to the game
                                // video behind a preview.
                                can-edit: root.can-play && !root.recording && !root.previewing;
                                // Off any field first, as every other button
                                // does: a click doesn't take focus from one, and
                                // the tag keys have to keep working after it.
                                tag(kind) => {
                                    keys.focus();
                                    root.tag-match-event(kind);
                                }
                                seek(id) => {
                                    keys.focus();
                                    root.seek-match-event(id);
                                }
                                remove(id) => {
                                    keys.focus();
                                    root.delete-match-event(id);
                                }
                                trim(id, trim) => {
                                    keys.focus();
                                    root.reel-trim(id, trim);
                                }
                                setup => {
                                    keys.focus();
                                    root.open-match-setup();
                                }
                            }

                            highlights := HighlightsPanel {
                                rows: root.highlight-rows;
                                selected: root.selected-highlight;
                                tool-on: root.in-highlight-tool;
                                key-here: root.highlight-key-here;
                                label-text <=> root.highlight-label;
                                // The bus refuses every highlight edit but a
                                // key while recording (H3), and none of them
                                // belongs to the game video behind a preview.
                                can-edit: root.can-play && !root.recording && !root.previewing;
                                // Off any field first, as the Match panel's
                                // buttons do.
                                select(id) => {
                                    keys.focus();
                                    root.select-highlight(id);
                                }
                                remove(id) => {
                                    keys.focus();
                                    root.delete-highlight(id);
                                }
                                delete-key(id) => {
                                    keys.focus();
                                    root.delete-highlight-key(id);
                                }
                                begin-edit => { root.editing-highlight-id = root.selected-highlight; }
                                commit(text) => { root.commit-highlight-label(text); }
                                end-edit(text) => {
                                    root.end-highlight-label(text);
                                    root.editing-highlight-id = "";
                                }
                            }
                        }
                    }
                }
            }

            // --- Transport bar: the scrubber on a row of its own, full width,
            // with the controls under it ---
            Rectangle {
                background: Palette.alternate-background;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    scrubber := Scrubber {
                        // Something to play, and not recording.
                        enabled: root.can-play && !root.recording;
                        maximum: max(root.total-seconds, 0.001);
                        // The concat timeline's: a preview's scale is its
                        // clip's, where they would mean nothing.
                        marks: root.previewing ? [] : root.match-marks;
                        value <=> root.position-seconds;
                        moved(value) => { root.scrub-move(value); }
                        released(value) => { root.scrub-release(value); }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Button {
                            text: "Open Project…";
                            enabled: !root.recording;
                            clicked => { root.open-project(); }
                        }
                        Button {
                            text: "Add Source Video…";
                            enabled: root.has-project && !root.recording;
                            clicked => { root.add-source(); }
                        }
                        Button {
                            text: root.playing ? "Pause" : "Play";
                            enabled: root.can-play;
                            min-width: 72px;
                            clicked => { root.toggle-play(); }
                        }
                        // Cycles up, and back to 1x after 32x.
                        Button {
                            text: root.scan-speed + "×";
                            enabled: root.can-scan-fast;
                            min-width: 48px;
                            clicked => {
                                root.step-scan-speed(ScanStep.cycle);
                            }

                            Tooltip {
                                text: @markdown("Speed while playing (J slower, L faster)");
                            }
                        }
                        Button {
                            text: root.recording ? "Stop" : "Record";
                            enabled: (root.can-play && !root.exporting && !root.previewing) || root.recording;
                            min-width: 72px;
                            // Off any field first: a click doesn't take focus
                            // from one, and a field disabled while it has
                            // focus would keep blocking the recording keys.
                            clicked => {
                                keys.focus();
                                root.toggle-recording();
                            }

                            Tooltip {
                                text: root.recording
                                    ? @markdown("Stop recording (R or Esc)")
                                    : root.exporting
                                        ? @markdown("Not while exporting")
                                        : root.previewing
                                            ? @markdown("Not while previewing a clip")
                                            : @markdown("Record (R)");
                            }
                        }
                        // The stretch item, right-aligned: it holds the
                        // controls either side of it apart.
                        Text {
                            text: root.readout;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            min-width: 130px;
                            horizontal-alignment: right;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "Volume";
                            color: Palette.alternate-foreground;
                            vertical-alignment: center;
                        }
                        Slider {
                            width: 100px;
                            minimum: 0;
                            maximum: 1;
                            value <=> root.volume;
                            changed(value) => { root.volume-changed(value); }
                            released(value) => { root.volume-released(value); }
                        }
                        Button {
                            text: "Export…";
                            // Still on while a run is going: the sheet is
                            // where one is watched and cancelled from.
                            enabled: root.has-project && root.can-export && !root.recording && !root.previewing;
                            clicked => {
                                keys.focus();
                                root.open-export();
                            }

                            Tooltip {
                                text: @markdown("Export clips, the goals reel, or the whole match, as videos");
                            }
                        }
                        Button {
                            text: "Devices…";
                            enabled: root.has-project && !root.recording;
                            clicked => {
                                root.list-devices();
                                devices-popup.show();
                            }
                        }
                    }

                    // Drawing's row, with the recording's status and the
                    // notice line: at the window's 1100px minimum, sharing
                    // the transport's row pushed Export and Devices off its
                    // end and left the notice no width at all.
                    HorizontalLayout {
                        spacing: 8px;

                        // Drawing's controls (D6). Always mounted, and
                        // only disabled off a recording: mounting them with
                        // the recording would change the player's height,
                        // and with it the content rect strokes are
                        // normalized against. macOS learned this one.
                        //
                        // The pens first, and never disabled: the coach picks
                        // one before a recording as well as during it. The
                        // chosen one has a ring round it.
                        HorizontalLayout {
                            spacing: 2px;
                            alignment: center;
                            // Layouts stretch by default; only the notice may.
                            horizontal-stretch: 0;

                            for ink[index] in root.pen-colors: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: self.width / 2;
                                    border-width: 2px;
                                    border-color: index == root.pen-index ? Palette.foreground : transparent;

                                    Rectangle {
                                        width: 14px;
                                        height: 14px;
                                        border-radius: self.width / 2;
                                        background: ink;
                                        // The strokes' own dark edge, so white
                                        // and yellow hold on a light theme.
                                        border-width: 1px;
                                        border-color: #00000066;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            keys.focus();
                                            root.pick-pen(index);
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            CheckBox {
                                text: "Auto-clear";
                                enabled: root.can-draw;
                                checked <=> root.auto-clear;
                            }
                        }
                        Button {
                            text: "Clear";
                            enabled: root.can-draw;
                            clicked => {
                                keys.focus();
                                root.clear-drawings();
                            }

                            Tooltip {
                                text: @markdown("Clear the drawings (C)");
                            }
                        }
                        // The H tool is a mode, so it says so (spec H3): the
                        // pen swatches beside it are what a new ring is
                        // coloured with, and the panel below lists them.
                        if root.in-highlight-tool: Text {
                            text: "Highlight tool — drag a box around a player (Esc to leave)";
                            color: Palette.foreground;
                            font-size: 11px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        if root.recording-phase == RecordingPhase.starting: Text {
                            text: "Preparing recording…";
                            color: Palette.alternate-foreground;
                            vertical-alignment: center;
                        }
                        if root.recording-phase == RecordingPhase.recording: HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: #ff3b30;
                                }
                            }
                            Text {
                                text: "Recording";
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.recording-elapsed;
                                color: Palette.foreground;
                                font-family: "monospace";
                                vertical-alignment: center;
                                min-width: 48px;
                            }
                            if !root.level-seen: Text {
                                text: "Waiting for audio…";
                                color: Palette.alternate-foreground;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            if root.level-seen: VerticalLayout {
                                alignment: center;
                                // The mic's peak over −60…0 dBFS.
                                Rectangle {
                                    width: 90px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: #ffffff26;

                                    Rectangle {
                                        x: 0;
                                        width: parent.width * root.level;
                                        border-radius: 3px;
                                        background: root.level > 0.95 ? #ff3b30 : #34c759;
                                    }
                                }
                            }
                        }
                        // Its own item, so a notice can't overwrite it (P6).
                        // The transport above drives the preview while it's
                        // up, over the clip's own duration.
                        if root.previewing: HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 0;

                            Text {
                                text: "Previewing " + root.previewing-name;
                                color: Palette.foreground;
                                font-size: 11px;
                                overflow: elide;
                                vertical-alignment: center;
                                max-width: 200px;
                            }
                            Button {
                                text: "Close";
                                clicked => {
                                    keys.focus();
                                    root.close-preview();
                                }

                                Tooltip {
                                    text: @markdown("Close the preview and go back to the game video (Esc)");
                                }
                            }
                        }
                        // The one stretch item: it takes the row's slack, and
                        // elides rather than squeeze the controls.
                        Text {
                            text: root.notice;
                            color: #ffcc00;
                            font-size: 11px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0;
                        }
                    }
                }

                // The Devices popover: above the bar's right end, over the player.
                devices-popup := PopupWindow {
                    x: parent.width - self.width - 8px;
                    y: -self.height - 8px;
                    width: 300px;

                    Rectangle {
                        background: Palette.background;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.border;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 12px;

                            DeviceList {
                                title: "Camera";
                                rows: root.cameras;
                                chosen(node-name) => { root.choose-camera(node-name); }
                            }
                            DeviceList {
                                title: "Microphone";
                                rows: root.mics;
                                chosen(node-name) => { root.choose-mic(node-name); }
                            }
                            InsetSection {
                                thumb: root.avatar-thumb;
                                name: root.avatar-name;
                                missing: root.avatar-missing;
                                choose() => { root.choose-avatar(); }
                                remove() => { root.remove-avatar(); }
                            }
                        }
                    }
                }
            }
        }

        // --- Export sheet: modal over the whole window (E8) ---
        if root.export-sheet-open: Rectangle {
            background: #000000a0;

            // Swallows clicks meant for the window behind.
            TouchArea { }

            ExportSheet {
                targets: root.export-targets;
                any-ticked: root.export-any-ticked;
                run: root.export-run;
                finish: root.export-finish;
                exporting: root.exporting;
                resolution <=> root.export-resolution;
                quality <=> root.export-quality;
                scoreboard <=> root.export-scoreboard;
                whole-match-ticked: root.export-whole-match-ticked;
                tick(index, ticked) => { root.tick-target(index, ticked); }
                start => { root.start-export(); }
                cancel => { root.cancel-export(); }
                close => {
                    root.export-sheet-open = false;
                    keys.focus();
                }
            }
        }

        // --- Match setup sheet: modal over the whole window (Phase 9 S4) ---
        if root.match-sheet-open: Rectangle {
            background: #000000a0;

            // Swallows clicks meant for the window behind.
            TouchArea { }

            MatchSetupSheet {
                home-name <=> root.match-home-name;
                home-primary <=> root.match-home-primary;
                home-secondary <=> root.match-home-secondary;
                home-font <=> root.match-home-font;
                away-name <=> root.match-away-name;
                away-primary <=> root.match-away-primary;
                away-secondary <=> root.match-away-secondary;
                away-font <=> root.match-away-font;
                regulation-periods <=> root.match-regulation-periods;
                regulation-minutes <=> root.match-regulation-minutes;
                overtime-periods <=> root.match-overtime-periods;
                overtime-minutes <=> root.match-overtime-minutes;
                back-anchor <=> root.match-back-anchor;
                hex-color(text) => { return root.hex-color(text); }
                valid-name(text) => { return root.valid-name(text); }
                valid-hex(text) => { return root.valid-hex(text); }
                valid-periods(text) => { return root.valid-periods(text); }
                valid-overtime-periods(text) => { return root.valid-overtime-periods(text); }
                valid-minutes(text) => { return root.valid-minutes(text); }
                over-cap(regulation, overtime, anchor) => {
                    return root.match-over-cap(regulation, overtime, anchor);
                }
                // The bus has the last word on both: it refuses an empty
                // name, and closing here is the sheet's own Cancel.
                save => {
                    root.save-match-setup();
                    root.close-match-setup();
                }
                cancel => { root.close-match-setup(); }
            }
        }

        // --- Error dialog: modal over the whole window ---
        if root.error-message != "": Rectangle {
            background: #000000a0;

            // Swallows clicks meant for the window behind.
            TouchArea { }

            Rectangle {
                width: 440px;
                height: dialog.preferred-height;
                background: Palette.background;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;

                dialog := VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    Text {
                        text: root.error-message;
                        color: Palette.foreground;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: "OK";
                            primary: true;
                            clicked => {
                                root.error-message = "";
                                keys.focus();
                            }
                        }
                    }
                }
            }
        }
    }
}
