// The transport's scrubber (spec D8): a std `Slider` for the looks, with the
// pointer handled here instead.
//
// Slint 1.18's `Slider` never fires `released` when Slint cancels a drag
// rather than ending it -- on X11, the moment a drag leaves the window: the
// cancel comes with no button, and the slider ignores every event whose
// button isn't the left one. A scrub that never releases leaves
// `scrubbing` stuck: the readout and the scrubber stop following playback,
// and the frame-accurate landing never comes. This TouchArea sees every end:
// the pointer-up, and the cancel.

import { Slider } from "std-widgets.slint";

/// A tick over the track: a chapter (spec C1), at `at` on the scrubber's own
/// scale.
export struct Mark {
    at: float,
    color: color,
}

export component Scrubber {
    in property <bool> enabled;
    /// The wheel over the track moves the playhead. Gated on its own, not on
    /// `enabled`: a wheel sends a **skip**, which the bus allows mid-take,
    /// while a scrub is refused there (see `wheel.rs`).
    in property <bool> wheel-enabled;
    in property <float> maximum;
    /// Drawn on the track, under the thumb and the pointer: a click on a
    /// mark scrubs there like anywhere else.
    in property <[Mark]> marks;
    in-out property <float> value;
    /// A scrub is under way: from the press to its end, however it ends.
    out property <bool> scrubbing;
    /// Every value the pointer reaches, the press's included.
    callback moved(float);
    /// Where a scrub ended: a pointer-up, or a cancelled drag, which lands
    /// where it had got to. Not when disabled mid-drag: see below.
    callback released(float);
    /// A wheel over the track: the raw scroll deltas and whether Shift was
    /// held. Rust adds them up into whole notches and skips by them.
    callback scrolled(/* dx */ length, /* dy */ length, /* shift */ bool);

    min-height: slider.min-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    /// Disabled mid-drag (a recording starting): the scrub just ends. The bus
    /// refuses a scrub then, so there is nothing to release.
    changed enabled => {
        if (!self.enabled) {
            self.scrubbing = false;
        }
    }

    /// The value under `x`, on the Fluent slider's geometry: its 20px thumb's
    /// centre travels from one end of the track to the other.
    function value-at(x: length) -> float {
        return clamp((x - root.thumb / 2) / max(root.width - root.thumb, 1px), 0, 1) * root.maximum;
    }

    property <length> thumb: 20px;

    /// Where the value `at` is drawn: `value-at` turned round, so a mark sits
    /// exactly where a click scrubs to its value.
    public pure function mark-x(at: float) -> length {
        return root.thumb / 2 + clamp(at / max(root.maximum, 0.001), 0, 1) * (root.width - root.thumb);
    }

    function scrub-to(x: length) {
        root.value = value-at(x);
        root.moved(root.value);
    }

    // Before the slider, so its thumb paints over them.
    for mark in root.marks: Rectangle {
        x: root.mark-x(mark.at) - self.width / 2;
        y: (root.height - self.height) / 2;
        width: 2px;
        height: 12px;
        background: mark.color;
    }

    slider := Slider {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        minimum: 0;
        maximum: root.maximum;
        value: root.value;
    }

    // The wheel, behind the pointer area below: that one has no
    // `scroll-event`, so wheels fall through to this one, while presses stop
    // there whenever it is enabled. Declared here so a wheel still works
    // while a recording has disabled the scrub.
    TouchArea {
        enabled: root.wheel-enabled;
        scroll-event(event) => {
            // Never mid-drag: the pointer is already saying where to go.
            if (root.scrubbing) {
                return reject;
            }
            root.scrolled(event.delta-x, event.delta-y, event.modifiers.shift);
            return accept;
        }
    }

    // Above the slider and the marks, so it takes every pointer event.
    TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.scrubbing = true;
                root.scrub-to(self.mouse-x);
            } else if (root.scrubbing
                && ((event.kind == PointerEventKind.up && event.button == PointerEventButton.left)
                    || event.kind == PointerEventKind.cancel)) {
                root.scrubbing = false;
                root.released(root.value);
            }
        }
        moved => {
            if (root.scrubbing) {
                root.scrub-to(self.mouse-x);
            }
        }
    }
}
